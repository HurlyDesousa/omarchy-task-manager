#!/usr/bin/env bash
# Waybar exec for the Task Manager icon.
# Outputs JSON for waybar: icon, tooltip, and a CSS class when the app is running.

CLASS="art.sw.omarchy.TaskManager"

if hyprctl clients -j 2>/dev/null \
   | jq -e --arg c "$CLASS" 'any(.[]; .class == $c)' >/dev/null 2>&1; then
    printf '{"text":"󰓅","tooltip":"Task Manager (running)","class":"running"}\n'
else
    printf '{"text":"󰓅","tooltip":"Task Manager"}\n'
fi
