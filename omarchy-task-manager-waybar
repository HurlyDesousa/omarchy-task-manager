#!/usr/bin/env bash
# Waybar exec for the Task Manager icon.
# Outputs JSON: icon, tooltip, and a CSS class when the panel is open.

PLUGIN_ID="sw.art.task-manager"
OPEN="false"

if command -v omarchy-shell >/dev/null 2>&1; then
  OPEN="$(omarchy-shell -q "${PLUGIN_ID}" opened 2>/dev/null || echo false)"
fi

if [[ "$OPEN" == "true" ]]; then
  printf '{"text":"󰓅","tooltip":"Task Manager (open)","class":"running"}\n'
else
  printf '{"text":"󰓅","tooltip":"Task Manager"}\n'
fi
