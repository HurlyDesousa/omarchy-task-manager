#!/usr/bin/env bash
# Toggle the Task Manager KeyboardPanel via Omarchy shell IPC.
set -euo pipefail

PLUGIN_ID="sw.art.task-manager"

if command -v omarchy-shell >/dev/null 2>&1; then
  omarchy-shell -q shell toggle "${PLUGIN_ID}" '{}' 2>/dev/null \
    || omarchy-shell shell toggle "${PLUGIN_ID}" '{}'
  exit 0
fi

# Fallback when omarchy-shell is unavailable.
if command -v qs >/dev/null 2>&1 && [[ -n "${OMARCHY_PATH:-}" ]]; then
  qs ipc -n -p "${OMARCHY_PATH}/shell" call -- "${PLUGIN_ID}" toggle
  exit 0
fi

echo "omarchy-shell is not available; open Task Manager from the bar icon." >&2
exit 1
