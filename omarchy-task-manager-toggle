#!/usr/bin/env bash
# Toggle Task Manager window: launch if not running; hide to or show from
# special:taskmanager using the Hyprland Lua eval API.
# Replaces classic movetoworkspacesilent dispatch (fails rc7 on Lua Hyprland).
# App ID: art.sw.omarchy.TaskManager.

CLASS="art.sw.omarchy.TaskManager"
BIN="${HOME}/.local/bin/omarchy-task-manager"

CLIENT=$(hyprctl clients -j 2>/dev/null \
  | jq -c --arg c "$CLASS" '.[] | select(.class == $c)' 2>/dev/null \
  | head -1)

if [[ -z "$CLIENT" ]]; then
    setsid "$BIN" </dev/null >/dev/null 2>&1 &
    exit 0
fi

ADDRESS=$(printf '%s' "$CLIENT" | jq -r '.address')
WS_NAME=$(printf '%s' "$CLIENT" | jq -r '.workspace.name')

if [[ "$WS_NAME" == special:* ]]; then
    # Window is already in the special workspace; toggle it back into view.
    hyprctl eval 'hl.dsp.workspace.toggle_special("taskmanager")' >/dev/null 2>&1
else
    # Move window to special:taskmanager (hide), without warping the display.
    hyprctl eval "hl.dsp.window.move({ workspace = \"special:taskmanager\", follow = false, window = \"address:${ADDRESS}\" })" >/dev/null 2>&1
fi
