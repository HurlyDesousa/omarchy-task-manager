def _norm_color(value: str) -> str:
    value = value.strip().strip('"').strip("'").rstrip(";").strip()
    if re.fullmatch(r"[0-9A-Fa-f]{3,8}", value):
        return "#" + value
    return value


def _css_color(value: str | None, fallback: str) -> str:
    if not value:
        return fallback
    v = value.strip()
    if v.startswith("@"):
        return fallback
    if re.fullmatch(r"#[0-9A-Fa-f]{3,8}", v):
        return v
    if re.fullmatch(r"(?:rgba?|hsla?)\([^;{}]+\)", v, re.I):
        return v
    return fallback


def _load_colors_toml(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    try:
        import tomllib

        with path.open("rb") as fh:
            data = tomllib.load(fh)
    except Exception:
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return out
        for key, val in TOML_STR_RE.findall(text):
            out[key.lower()] = _norm_color(val)
        return out

    def walk(node: object) -> None:
        if isinstance(node, dict):
            for key, val in node.items():
                if isinstance(val, str):
                    out[str(key).lower()] = _norm_color(val)
                else:
                    walk(val)

    walk(data)
    return out


def _load_waybar_css(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return out
    for key, val in DEFINE_COLOR_RE.findall(text):
        out[key.lower()] = _norm_color(val)
    return out


def _gtk_named_colors() -> tuple[str, str, str]:
    """GTK / Adwaita-dark named colors when Omarchy theme files are absent."""
    try:
        settings = Gtk.Settings.get_default()
        if settings:
            theme = str(settings.get_property("gtk-theme-name") or "")
            prefer_dark = bool(
                settings.get_property("gtk-application-prefer-dark-theme")
            )
            if prefer_dark or "dark" in theme.lower():
                return FALLBACK_BG, FALLBACK_FG, FALLBACK_FG
            return "#f6f5f4", "#2e3436", "#3584e4"
    except Exception:
        pass
    return FALLBACK_BG, FALLBACK_FG, FALLBACK_FG


def load_theme_colors() -> tuple[str, str, str]:
    gtk_bg, gtk_fg, gtk_accent = _gtk_named_colors()
    colors: dict[str, str] = {}
    theme_root = THEME_DIR
    try:
        if theme_root.is_symlink():
            theme_root = theme_root.resolve()
    except OSError:
        pass
    toml_path = theme_root / "colors.toml"
    css_path = theme_root / "waybar.css"
    if toml_path.is_file():
        colors.update(_load_colors_toml(toml_path))
    if css_path.is_file():
        colors.update(_load_waybar_css(css_path))
    bg = _css_color(colors.get("background"), gtk_bg)
    fg = _css_color(colors.get("foreground"), gtk_fg)
    accent = _css_color(
        colors.get("accent")
        or colors.get("color4")
        or colors.get("blue")
        or colors.get("theme-blue"),
        gtk_accent,
    )
    return bg, fg, accent


