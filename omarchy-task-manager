    # ── Startup / map / close ─────────────────────

    def _apply_startup_state(self) -> None:
        start_compact = self._prefs.get("start_compact", False)
        remember = self._prefs.get("remember_expand", True)
        last_compact = self._prefs.get("last_compact", True)
        if start_compact or (remember and last_compact):
            # Start compact: stats strip only
            self._expanded = False
            w, h = quarter_monitor_size()
            self.set_default_size(w, h)
        else:
            # Start expanded: show process list immediately
            self._expanded = True
            self._root.append(self._process_box)
            self.expand_btn.set_label("Processes \u25b4")
            w, h = expanded_monitor_size()
            self.set_default_size(w, h)

    def _on_map(self, *_args) -> None:
        try:
            self.unmaximize()
        except Exception:
            pass
        if not self._startup_hide_done and self._prefs.get("start_hidden", True):
            self._startup_hide_done = True
            # Wait ~150 ms so Hyprland has registered the window before we move it.
            GLib.timeout_add(150, self._do_startup_hide)

    def _do_startup_hide(self) -> bool:
        threading.Thread(
            target=self._hide_to_special, daemon=True, name="startup-hide"
        ).start()
        return False

    def _on_close(self, *_args) -> bool:
        if self._tick_id:
            GLib.source_remove(self._tick_id)
            self._tick_id = 0
        if self._focus_out_id:
            GLib.source_remove(self._focus_out_id)
            self._focus_out_id = 0
        if self._prefs.get("remember_expand", True):
            self._prefs["last_compact"] = not self._expanded
            save_prefs(self._prefs)
        return False

    # ── Click-outside / focus-out dismiss ────────

    def _on_is_active_changed(self, _window, _pspec) -> None:
        """Schedule a hide when the window loses focus; cancel if it regains it."""
        if self.get_property("is-active"):
            if self._focus_out_id:
                GLib.source_remove(self._focus_out_id)
                self._focus_out_id = 0
            return
        if self._focus_out_id:
            return
        self._focus_out_id = GLib.timeout_add(250, self._maybe_hide_to_special)

    def _maybe_hide_to_special(self) -> bool:
        """Fired 250 ms after focus-out.  Hide unless a child dialog is active."""
        self._focus_out_id = 0
        # Regained focus in the meantime — stay visible.
        if self.get_property("is-active"):
            return False
        # A child window (e.g. ConfirmDialog) is active — that's still "inside the app".
        app = self.get_application()
        if app is not None:
            for win in app.get_windows():
                if win is not self and win.get_visible() and win.get_property("is-active"):
                    return False
        threading.Thread(
            target=self._hide_to_special, daemon=True, name="hide-self"
        ).start()
        return False

    def _hide_to_special(self) -> None:
        """Hide the Task Manager window.

        Two cases:
        - Window is on a regular workspace (first launch, or moved back by Hyprland):
          move it to special:taskmanager with follow=false so the special workspace
          is NOT shown — identical to omarchy-task-manager-toggle's hide path.
        - Window is already in special:taskmanager but the workspace overlay is
          currently visible (shown via bar icon → toggle_special): call
          toggle_special to collapse the overlay.  We confirm visibility first
          via hyprctl monitors to avoid accidentally *showing* the overlay when
          it is already hidden (e.g. after the toggle script's own window.move).
        """
        try:
            out = subprocess.run(
                ["hyprctl", "clients", "-j"],
                capture_output=True, text=True, timeout=2.0, check=False,
                stdin=subprocess.DEVNULL,
            )
            if out.returncode != 0 or not out.stdout.strip():
                return
            clients = json.loads(out.stdout)
        except Exception:
            return
        addr = ""
        ws_name = ""
        for c in clients:
            if c.get("class") == APP_ID:
                ws_name = c.get("workspace", {}).get("name", "")
                addr = c.get("address", "")
                break
        if not addr:
            return
        if ws_name.startswith("special:"):
            # Already in the special workspace. Only call toggle_special when
            # the overlay is actually visible; if it is already hidden there is
            # nothing to do (and calling toggle_special would wrongly show it).
            try:
                mon = subprocess.run(
                    ["hyprctl", "monitors", "-j"],
                    capture_output=True, text=True, timeout=2.0, check=False,
                    stdin=subprocess.DEVNULL,
                )
                if mon.returncode != 0 or not mon.stdout.strip():
                    return
                monitors = json.loads(mon.stdout)
            except Exception:
                return
            visible = any(
                m.get("specialWorkspace", {}).get("name") == "special:taskmanager"
                for m in monitors
            )
            if not visible:
                return
            try:
                subprocess.run(
                    [
                        "hyprctl", "eval",
                        'hl.dispatch(hl.dsp.workspace.toggle_special("taskmanager"))',
                    ],
                    capture_output=True, timeout=2.0, check=False,
                    stdin=subprocess.DEVNULL,
                )
            except Exception:
                pass
        else:
            # On a regular workspace: move silently to special:taskmanager.
            try:
                subprocess.run(
                    [
                        "hyprctl", "eval",
                        f'hl.dispatch(hl.dsp.window.move({{ workspace = "special:taskmanager",'
                        f' follow = false, window = "address:{addr}" }})',
                    ],
                    capture_output=True, timeout=2.0, check=False,
                    stdin=subprocess.DEVNULL,
                )
            except Exception:
                pass

    # ── Expand / collapse ─────────────────────────

    def _apply_window_geometry(self, expanded: bool) -> None:
        w, h = expanded_monitor_size() if expanded else quarter_monitor_size()
        self.set_default_size(w, h)

    def _toggle_processes(self, *_args) -> None:
        self._expanded = not self._expanded
        if self._expanded:
            overall, cores = read_proc_stat()
            self._refresh_procs(overall, cores)
            self._root.append(self._process_box)
            self.expand_btn.set_label("Processes \u25b4")
        else:
            self._root.remove(self._process_box)
            self.expand_btn.set_label("Processes \u25be")
        self._apply_window_geometry(self._expanded)

    # ── Settings callbacks ────────────────────────

    def _on_p_start_compact(self, btn: Gtk.CheckButton) -> None:
        self._prefs["start_compact"] = btn.get_active()
        save_prefs(self._prefs)

    def _on_p_remember(self, btn: Gtk.CheckButton) -> None:
        self._prefs["remember_expand"] = btn.get_active()
        save_prefs(self._prefs)

    def _on_p_start_hidden(self, btn: Gtk.CheckButton) -> None:
        self._prefs["start_hidden"] = btn.get_active()
        save_prefs(self._prefs)

    def _on_p_refresh(self, dropdown: Gtk.DropDown, _pspec) -> None:
        ms_values = [500, 1000, 2000, 5000]
        idx = dropdown.get_selected()
        ms = ms_values[idx] if 0 <= idx < len(ms_values) else 1000
        self._prefs["refresh_ms"] = ms
        save_prefs(self._prefs)
        if self._tick_id:
            GLib.source_remove(self._tick_id)
        self._tick_id = GLib.timeout_add(ms, self._tick)

    def _on_p_autostart(self, btn: Gtk.CheckButton) -> None:
        want = btn.get_active()
        err = _set_autostart(want)
        if err:
            btn.handler_block_by_func(self._on_p_autostart)
            btn.set_active(not want)
            btn.handler_unblock_by_func(self._on_p_autostart)
            self._alert("Autostart failed", err)

    # ── Main tick ─────────────────────────────────

    def _tick(self) -> bool:
        try:
            overall, cores = read_proc_stat()
            self._refresh_cpu(overall, cores)
            self._refresh_gpu()
            self._refresh_ram()
            self._refresh_uptime()
            self._refresh_temp()
            self._refresh_procs(overall, cores)
            self._schedule_fan()
        except Exception:
            pass
        return True

    def _refresh_cpu(
        self,
        overall: tuple[int, int] | None,
        cores: dict[int, tuple[int, int]],
    ) -> None:
        if overall is None:
            return
        pct = cpu_pct(self._prev_overall, overall)
        self.cpu_value.set_text(f"{pct:.0f}%")
        self.cpu_bar.set_fraction(pct / 100.0)
        ids = sorted(cores)
        self._ensure_core_bars(ids)
        for i, idx in enumerate(ids):
            cur = cores[idx]
            prev = self._prev_cores.get(idx)
            core_pct = cpu_pct(prev, cur)
            self._core_bars[i].set_fraction(core_pct / 100.0)
            self._core_bars[i].set_tooltip_text(f"cpu{idx}  {core_pct:.0f}%")
        self._prev_overall = overall
        self._prev_cores = cores

    def _refresh_gpu(self) -> None:
        usage = read_gpu_usage()
        if usage is None:
            self.gpu_value.set_text(EM_DASH)
            self.gpu_bar.set_fraction(0.0)
        else:
            self.gpu_value.set_text(f"{usage:.0f}%")
            self.gpu_bar.set_fraction(usage / 100.0)
        temp = read_gpu_temp()
        self.gpu_temp_label.set_text(
            EM_DASH if temp is None else f"{temp:.0f}\u00b0C"
        )

    def _refresh_ram(self) -> None:
        mem = read_mem_usage()
        if mem is None:
            self.ram_value.set_text(EM_DASH)
            self.ram_bar.set_fraction(0.0)
            self.ram_detail_label.set_text(EM_DASH)
            return
        used_kib, total_kib, pct = mem
        self.ram_value.set_text(f"{pct:.0f}%")
        self.ram_bar.set_fraction(pct / 100.0)
        self.ram_detail_label.set_text(fmt_mem_gib_pair(used_kib, total_kib))

    def _refresh_uptime(self) -> None:
        uptime = read_uptime()
        self.uptime_label.set_text(
            EM_DASH if uptime is None else fmt_uptime(uptime)
        )

    def _refresh_temp(self) -> None:
        temp = read_cpu_temp()
        self.cpu_temp_label.set_text(
            EM_DASH if temp is None else f"{temp:.0f}\u00b0C"
        )

    def _ensure_core_bars(self, ids: list[int]) -> None:
        if ids == self._core_ids and len(self._core_bars) == len(ids):
            return
        if hasattr(self.core_flow, "remove_all"):
            self.core_flow.remove_all()
        else:
            child = self.core_flow.get_first_child()
            while child is not None:
                nxt = child.get_next_sibling()
                self.core_flow.remove(child)
                child = nxt
        self._core_bars = []
        self._core_ids = list(ids)
        for idx in ids:
            cell = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            lab = Gtk.Label(label=str(idx), xalign=1)
            lab.set_width_chars(2)
            _add_css_class(lab, "dim")
            bar = Gtk.ProgressBar()
            _add_css_class(bar, "cpu-core")
            bar.set_valign(Gtk.Align.CENTER)
            bar.set_hexpand(True)
            cell.append(lab)
            cell.append(bar)
            self.core_flow.insert(cell, -1)
            self._core_bars.append(bar)

    def _apply_fan(self, left: int | None, right: int | None) -> bool:
        try:
            self.fan_left_bar.set_fraction(fan_meter_fraction(left))
            self.fan_left_val.set_text(fmt_fan_meter(left))
            self.fan_right_bar.set_fraction(fan_meter_fraction(right))
            self.fan_right_val.set_text(fmt_fan_meter(right))
        except Exception:
            pass
        self._fan_busy = False
        return False

    def _fan_worker(self) -> None:
        try:
            left, right = read_fan_speeds()
        except Exception:
            left, right = None, None
        GLib.idle_add(self._apply_fan, left, right)

    def _schedule_fan(self) -> None:
        if self._fan_busy:
            return
        self._fan_busy = True
        thread = threading.Thread(target=self._fan_worker, name="fan-rpm", daemon=True)
        thread.start()

    def _refresh_procs(
        self,
        overall: tuple[int, int] | None,
        cores: dict[int, tuple[int, int]],
    ) -> None:
        if overall is None:
            return
        total_jiffies = overall[0] + overall[1]
        ncpu = max(1, len(cores))
        prev_total = self._prev_total_jiffies
        d_total = (total_jiffies - prev_total) if prev_total is not None else 0
        selected = self._selected_row()
        selected_pid = selected[0] if selected else None

        live: set[int] = set()
        seen_keys: set[tuple[int, int]] = set()
        for pid, name, jiffies, rss, starttime in iter_processes():
            live.add(pid)
            key = (pid, starttime)
            seen_keys.add(key)
            cpu = 0.0
            prev = self._prev_proc.get(key)
            if prev is not None and d_total > 0:
                cpu = max(0.0, 100.0 * (jiffies - prev) / d_total * ncpu)
            self._prev_proc[key] = jiffies
            cpu_txt = f"{cpu:.1f}"
            rss_txt = fmt_bytes(rss)
            tree_iter = self._row_iters.get(pid)
            if tree_iter is None:
                tree_iter = self.store.append(
                    [name, pid, cpu, cpu_txt, rss, rss_txt]
                )
                self._row_iters[pid] = tree_iter
            else:
                self.store.set(
                    tree_iter,
                    COL_NAME, name, COL_PID, pid,
                    COL_CPU, cpu, COL_CPU_TXT, cpu_txt,
                    COL_RSS, rss, COL_RSS_TXT, rss_txt,
                )

        for pid in list(self._row_iters):
            if pid not in live:
                self.store.remove(self._row_iters[pid])
                del self._row_iters[pid]
        for key in list(self._prev_proc):
            if key not in seen_keys:
                del self._prev_proc[key]

        self._prev_total_jiffies = total_jiffies
        if selected_pid is not None and selected_pid in self._row_iters:
            try:
                path = self.store.get_path(self._row_iters[selected_pid])
                fpath = self.filtered.convert_child_path_to_path(path)
                if fpath is not None:
                    spath = self.sorted.convert_child_path_to_path(fpath)
                    if spath is not None:
                        self.tree.get_selection().select_path(spath)
            except Exception:
                pass

    # ── Process selection / actions ──────────────

    def _on_search(self, entry: Gtk.Entry) -> None:
        self._filter_text = (entry.get_text() or "").strip().lower()
        self.filtered.refilter()

    def _row_visible(self, model, tree_iter, _data=None) -> bool:
        needle = self._filter_text
        if not needle:
            return True
        name = str(model.get_value(tree_iter, COL_NAME) or "").lower()
        pid = str(model.get_value(tree_iter, COL_PID))
        return needle in name or needle in pid

    def _selected_row(self) -> tuple[int, str, int | None] | None:
        if not self._expanded:
            return None
        model, tree_iter = self.tree.get_selection().get_selected()
        if tree_iter is None:
            return None
        pid = int(model.get_value(tree_iter, COL_PID))
        name = str(model.get_value(tree_iter, COL_NAME))
        start = None
        try:
            with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as fh:
                parsed = _comm_from_stat(fh.read())
            if parsed and len(parsed[1]) >= 20:
                start = int(parsed[1][19])
        except (OSError, ValueError):
            start = None
        return pid, name, start

    def _on_sel(self, *_args) -> None:
        self.end_btn.set_sensitive(self._selected_row() is not None)

    def _on_row_activated(self, *_args) -> None:
        self._on_end_clicked()

    def _on_end_clicked(self, *_args) -> None:
        row = self._selected_row()
        if row is None:
            return
        pid, name, start = row
        if pid <= 1 or pid == os.getpid():
            self._alert("Cannot end this process", f"{name} (PID {pid}) is protected.")
            return
        ConfirmDialog(
            self,
            "End process?",
            f"Send SIGTERM to {name} (PID {pid})?",
            "End process",
            lambda ok, p=pid, n=name, st=start: self._do_term(p, n, st) if ok else None,
        ).present()

    def _alert(self, heading: str, body: str) -> None:
        ConfirmDialog(self, heading, body, "OK", lambda _ok: None).present()

    def _do_term(self, pid: int, name: str, start: int | None) -> None:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        except PermissionError:
            self._alert("Permission denied", f"Cannot send SIGTERM to {name} (PID {pid}).")
            return
        except OSError as exc:
            self._alert("Could not end process", f"{name} (PID {pid}): {exc}")
            return
        GLib.timeout_add(2000, self._check_after_term, pid, name, start)

    def _check_after_term(self, pid: int, name: str, start: int | None) -> bool:
        if not pid_alive(pid, start):
            return False
        ConfirmDialog(
            self,
            "Process still running",
            f"{name} (PID {pid}) is still alive. Send SIGKILL?",
            "Kill process",
            lambda ok, p=pid, n=name, st=start: self._do_kill(p, n, st) if ok else None,
        ).present()
        return False

    def _do_kill(self, pid: int, name: str, start: int | None) -> None:
        if not pid_alive(pid, start):
            return
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            return
        except PermissionError:
            self._alert("Permission denied", f"Cannot send SIGKILL to {name} (PID {pid}).")
        except OSError as exc:
            self._alert("Could not kill process", f"{name} (PID {pid}): {exc}")


# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────

class TaskManagerApp(Gtk.Application):
    def __init__(self) -> None:
        flags = getattr(Gio.ApplicationFlags, "DEFAULT_FLAGS", None)
        if flags is None:
            flags = Gio.ApplicationFlags.FLAGS_NONE
        super().__init__(application_id=APP_ID, flags=flags)
        self._window: TaskManagerWindow | None = None
        self._theme_monitors: list[Gio.FileMonitor] = []

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        apply_theme()
        self._theme_monitors = watch_theme_dir(apply_theme)

    def do_shutdown(self) -> None:
        for monitor in self._theme_monitors:
            try:
                monitor.cancel()
            except Exception:
                pass
        self._theme_monitors = []
        Gtk.Application.do_shutdown(self)

    def do_activate(self) -> None:
        if self._window is None:
            self._window = TaskManagerWindow(application=self)
        self._window.present()
        try:
            self._window.unmaximize()
        except Exception:
            pass


def main() -> int:
    app = TaskManagerApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
