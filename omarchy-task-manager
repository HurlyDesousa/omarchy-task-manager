        "updatedAt": _usage_now_iso(),
        "ready": False,
        "hasLocalStats": False,
        "tierLabel": "",
        "usageStatusText": "unavailable",
        "authHelpText": "",
        "limits": [],
        "todayTotalTokens": 0,
        "todayPrompts": 0,
        "todaySessions": 0,
        "recentDays": [],
        "modelUsage": {},
    }


def _usage_record_score(record: dict | None) -> int:
    if not record:
        return 0
    score = 0
    limits = record.get("limits") if isinstance(record.get("limits"), list) else []
    if limits:
        score += 10 + len(limits)
    if record.get("ready") is True:
        score += 4
    if record.get("hasLocalStats") is True:
        score += 2
    if _usage_number(record.get("todayTotalTokens")) > 0:
        score += 1
    if str(record.get("tierLabel") or "").strip():
        score += 1
    status = str(record.get("usageStatusText") or "").lower()
    if "unavailable" in status or "not loaded" in status or status == "unavailable":
        score -= 6
    return score


def _usage_load_state_file(path: Path) -> dict | None:
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def _usage_read_record(agent_id: str) -> dict | None:
    candidates: list[dict] = []
    primary = _usage_load_state_file(USAGE_STATE_DIR / f"{agent_id}.json")
    if primary is not None:
        candidates.append(_usage_normalize_record(agent_id, primary))
    for legacy_id in AGENT_USAGE_LEGACY_IDS.get(agent_id, ()):
        legacy = _usage_load_state_file(USAGE_STATE_DIR / f"{legacy_id}.json")
        if legacy is not None:
            candidates.append(_usage_normalize_record(agent_id, legacy, legacy_id=legacy_id))
    if not candidates:
        return None
    return max(candidates, key=_usage_record_score)


def _usage_normalize_record(agent_id: str, record: dict, legacy_id: str | None = None) -> dict:
    normalized = dict(record)
    normalized["id"] = agent_id
    name = str(normalized.get("name") or "").strip()
    legacy_names = {"Codex", "codex"} if agent_id == "grokbot" else set()
    if not name or name in legacy_names or (legacy_id and name.lower() == legacy_id):
        normalized["name"] = AGENT_USAGE_NAMES.get(agent_id, agent_id)
    elif agent_id == "grok" and name in ("Grok", "Grok Build"):
        normalized["name"] = AGENT_USAGE_NAMES["grok"]
    return normalized


def _usage_write_record(agent_id: str, record: dict) -> None:
    try:
        USAGE_STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = USAGE_STATE_DIR / f".{agent_id}.{os.getpid()}.tmp"
        payload = json.dumps(record, separators=(",", ":"), ensure_ascii=False)
        tmp.write_text(payload + "\n", encoding="utf-8")
        tmp.replace(USAGE_STATE_DIR / f"{agent_id}.json")
    except Exception:
        pass


def _usage_collector_paths(agent_id: str) -> list[Path]:
    names: list[str] = []
    seen_names: set[str] = set()
    for candidate in (agent_id, *AGENT_USAGE_COLLECTOR_FALLBACKS.get(agent_id, ())):
        collector_name = f"omarchy-agent-usage-{candidate}"
        if collector_name in seen_names:
            continue
        seen_names.add(collector_name)
        names.append(collector_name)
    roots = []
    omarchy_path = os.environ.get("OMARCHY_PATH")
    if omarchy_path:
        roots.append(Path(omarchy_path) / "bin")
    roots.extend(
        [
            Path("/usr/share/omarchy/bin"),
            Path.home() / ".local/share/omarchy-rs/bin",
            Path.home() / ".local/bin",
        ]
    )
    paths: list[Path] = []
    for name in names:
        found = shutil.which(name)
        if found:
            paths.append(Path(found))
        for root in roots:
            candidate = root / name
            if candidate.is_file():
                paths.append(candidate)
    # Preserve order, drop duplicates.
    seen: set[str] = set()
    unique: list[Path] = []
    for path in paths:
        key = str(path)
        if key in seen:
            continue
        seen.add(key)
        unique.append(path)
    return unique


def _usage_run_collector(agent_id: str) -> tuple[bool, str]:
    errors: list[str] = []
    for collector in _usage_collector_paths(agent_id):
        try:
            proc = subprocess.run(
                [str(collector)],
                capture_output=True,
                text=True,
                timeout=120,
                check=False,
            )
        except Exception as exc:
            errors.append(f"{collector.name}: {exc}")
            continue
        record = (proc.stdout or "").strip()
        if proc.returncode != 0 or not record:
            detail = (proc.stderr or proc.stdout or "").strip().splitlines()
            snippet = detail[-1] if detail else f"exit {proc.returncode}"
            errors.append(f"{collector.name}: {snippet}")
            continue
        try:
            parsed = json.loads(record)
        except json.JSONDecodeError as exc:
            errors.append(f"{collector.name}: invalid JSON ({exc})")
            continue
        if not isinstance(parsed, dict):
            errors.append(f"{collector.name}: unexpected record type")
            continue
        _usage_write_record(agent_id, parsed)
        return True, ""
    if not _usage_collector_paths(agent_id):
        return False, f"omarchy-agent-usage-{agent_id} not found on PATH"
    return False, errors[-1] if errors else f"omarchy-agent-usage-{agent_id} failed"


def _usage_run_omarchy_update(agents: tuple[str, ...]) -> str:
    omarchy = shutil.which("omarchy")
    if not omarchy:
        return "omarchy CLI not found"
    args = [omarchy, "agent", "usage-update", *agents]
    try:
        proc = subprocess.run(args, capture_output=True, text=True, timeout=180, check=False)
    except Exception as exc:
        return str(exc)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        return detail.splitlines()[-1] if detail else f"omarchy agent usage-update exit {proc.returncode}"
    return ""


def _usage_add_tokens(
    day: str,
    model: str,
    tokens: int,
    *,
    today: str,
    today_tokens: int,
    total_tokens: int,
    model_usage: dict,
) -> tuple[int, int]:
    if tokens <= 0:
        return today_tokens, total_tokens
    total_tokens += tokens
    if day == today:
        today_tokens += tokens
    bucket = model_usage.setdefault(
        model,
        {
            "inputTokens": 0,
            "outputTokens": 0,
            "cacheReadInputTokens": 0,
            "cacheCreationInputTokens": 0,
        },
    )
    bucket["outputTokens"] = _usage_number(bucket.get("outputTokens")) + tokens
    return today_tokens, total_tokens


def _usage_cursor_vscdb_paths() -> list[Path]:
    home = Path.home()
    candidates: list[Path] = [
        home / ".config/Cursor/User/globalStorage/state.vscdb",
        home / ".config/cursor/User/globalStorage/state.vscdb",
        home / ".cursor/User/globalStorage/state.vscdb",
        home / "snap/cursor/current/.config/Cursor/User/globalStorage/state.vscdb",
    ]
    for pattern in (
        ".config/*/User/globalStorage/state.vscdb",
        ".var/app/*/config/Cursor/User/globalStorage/state.vscdb",
        "snap/cursor/*/.config/Cursor/User/globalStorage/state.vscdb",
    ):
        for path in home.glob(pattern):
            if "ursor" in str(path).lower():
                candidates.append(path)
    seen: set[str] = set()
    found: list[Path] = []
    for path in candidates:
        key = str(path.resolve()) if path.exists() else str(path)
        if key in seen:
            continue
        seen.add(key)
        if path.is_file():
            found.append(path)
    return found


def _usage_scan_cursor_vscdb(db: Path, today: str) -> tuple[int, int, int, dict]:
    today_tokens = 0
    total_tokens = 0
    prompts = 0
    model_usage: dict = {}
    import sqlite3

    conn = sqlite3.connect(f"file:{db.resolve()}?mode=ro", uri=True, timeout=3)
    conn.execute("PRAGMA query_only = ON")
    rows = conn.execute("SELECT key, value FROM ItemTable").fetchall()
    conn.close()

    token_key_re = re.compile(r"token|usage|composer", re.IGNORECASE)
    for key, value in rows:
        if value is None:
            continue
        key_s = str(key or "")
        text = value.decode("utf-8", errors="replace") if isinstance(value, bytes) else str(value)
        if not token_key_re.search(key_s) and "composer" not in text[:200].lower():
            continue
        try:
            payload = json.loads(text)
        except json.JSONDecodeError:
            continue
        if not isinstance(payload, dict):
            continue

        candidates = [payload]
        if isinstance(payload.get("composerData"), dict):
            candidates.append(payload["composerData"])

        for item in candidates:
            breakdown = item.get("promptTokenBreakdown") or item.get("tokenBreakdown") or {}
            if isinstance(breakdown, dict):
                tokens = sum(_usage_number(v) for v in breakdown.values())
            else:
                tokens = _usage_number(item.get("totalTokens") or item.get("tokens"))
            if tokens <= 0:
                usage = item.get("usage") or {}
                tokens = _usage_number(usage.get("totalTokens") or usage.get("total_tokens"))
            if tokens <= 0:
                continue
            prompts += 1
            model = str(item.get("model") or item.get("modelName") or "cursor")
            today_tokens, total_tokens = _usage_add_tokens(
                today,
                model,
                tokens,
                today=today,
                today_tokens=today_tokens,
                total_tokens=total_tokens,
                model_usage=model_usage,
            )
    return today_tokens, total_tokens, prompts, model_usage


def _usage_collect_grok_local() -> dict:
    record = _usage_base_record("grok")
    grok_home = Path(os.environ.get("GROK_HOME", str(Path.home() / ".grok")))
    today = _usage_today()
    today_tokens = 0
    total_tokens = 0
    model_usage: dict = {}
    sessions = 0

    if not grok_home.is_dir():
        record["usageStatusText"] = "No local Grok sessions"
        record["authHelpText"] = (
            f"Run the grok CLI on this laptop; sessions under {grok_home}/sessions "
            "(no xAI API calls from this panel)."
        )
        return record

    for path in grok_home.glob("sessions/**/updates.jsonl"):
        sessions += 1
        try:
            with path.open(encoding="utf-8", errors="replace") as handle:
                for raw in handle:
                    raw = raw.strip()
                    if not raw:
                        continue
                    try:
                        entry = json.loads(raw)
                    except json.JSONDecodeError:
                        continue
                    if entry.get("type") != "turn_completed":
                        continue
                    usage = entry.get("usage") or {}
                    tokens = _usage_number(usage.get("total_tokens"))
                    if not tokens:
                        tokens = (
                            _usage_number(usage.get("input_tokens"))
                            + _usage_number(usage.get("output_tokens"))
                            + _usage_number(usage.get("cache_read_input_tokens"))
                            + _usage_number(usage.get("cache_creation_input_tokens"))
                        )
                    if tokens <= 0:
                        continue
                    ts = entry.get("timestamp") or entry.get("created_at") or path.stat().st_mtime
                    if isinstance(ts, (int, float)):
                        if ts > 10_000_000_000:
                            ts = ts / 1000
                        day = time.strftime("%Y-%m-%d", time.localtime(ts))
                    else:
                        day = str(ts)[:10] if ts else today
                    model = str(entry.get("model") or usage.get("model") or "grok")
                    today_tokens, total_tokens = _usage_add_tokens(
                        day,
                        model,
                        tokens,
                        today=today,
                        today_tokens=today_tokens,
                        total_tokens=total_tokens,
                        model_usage=model_usage,
                    )
        except OSError:
            continue

    if total_tokens > 0:
        record.update(
            {
                "ready": True,
                "hasLocalStats": True,
                "usageStatusText": "",
                "authHelpText": "Weekly quota: Grok Settings → Usage",
                "todayTotalTokens": today_tokens,
                "todayPrompts": today_tokens,
                "todaySessions": sessions,
                "modelUsage": model_usage,
            }
        )
    else:
        record["usageStatusText"] = "No local Grok usage yet"
        record["authHelpText"] = (
            "Run the grok CLI in a terminal on this laptop; "
            "sessions under ~/.grok/sessions are counted locally (no xAI API calls)."
        )
    return record


def _usage_collect_cursor_local() -> dict:
    record = _usage_base_record("cursor")
    dbs = _usage_cursor_vscdb_paths()
    if not dbs:
        record["usageStatusText"] = "Cursor database not found"
        record["authHelpText"] = (
            "Sign in to Cursor on this laptop (~/.local/bin/cursor). "
            "Looked under ~/.config/Cursor, ~/.config/cursor, ~/.cursor, and snap paths."
        )
        return record

    today = _usage_today()
    today_tokens = 0
    total_tokens = 0
    prompts = 0
    model_usage: dict = {}
    errors: list[str] = []

    for db in dbs:
        try:
            t_day, t_total, t_prompts, t_models = _usage_scan_cursor_vscdb(db, today)
        except Exception as exc:
            errors.append(f"{db.name}: {exc}")
            continue
        today_tokens += t_day
        total_tokens += t_total
        prompts += t_prompts
        for model, bucket in t_models.items():
            merged = model_usage.setdefault(
                model,
                {
                    "inputTokens": 0,
                    "outputTokens": 0,
                    "cacheReadInputTokens": 0,
                    "cacheCreationInputTokens": 0,
                },
            )
            for field in merged:
                merged[field] += _usage_number(bucket.get(field))

    if total_tokens > 0:
        record.update(
            {
                "ready": True,
                "hasLocalStats": True,
                "usageStatusText": "Estimated from Cursor local state",
                "authHelpText": f"Read {len(dbs)} local DB(s); see Cursor admin console for billing.",
                "todayTotalTokens": today_tokens,
                "todayPrompts": prompts,
                "modelUsage": model_usage,
            }
        )
    elif dbs:
        record.update(
            {
                "ready": True,
                "hasLocalStats": True,
                "usageStatusText": "Signed in — no token totals in local state yet",
                "authHelpText": (
                    "Cursor local DB found; send a chat in the IDE, then refresh."
                ),
            }
        )
    else:
        record["usageStatusText"] = "No Cursor token data in local state"
        record["authHelpText"] = (
            "Sign in to Cursor on this laptop and use the IDE, then refresh."
            + (f" ({errors[-1]})" if errors else "")
        )
    return record


def _usage_parse_reset_datetime(value: Any) -> time.struct_time | None:
    raw = str(value or "").strip()
    if not raw:
        return None
    try:
        if raw.endswith("Z"):
            raw = raw[:-1] + "+00:00"
        dt = datetime.fromisoformat(raw)
        if dt.tzinfo is not None:
            dt = dt.astimezone()
        return dt.timetuple()
    except ValueError:
        pass
    if len(raw) >= 10 and raw[4] == "-" and raw[7] == "-":
        try:
            return time.strptime(raw[:10], "%Y-%m-%d")
        except ValueError:
            return None
    return None


def _usage_reset_caption(resets_at: Any) -> str:
    reset = _usage_parse_reset_datetime(resets_at)
    if reset is None:
        return ""
    now = time.localtime()
    reset_day = time.mktime(
        (reset.tm_year, reset.tm_mon, reset.tm_mday, 0, 0, 0, 0, 0, -1)
    )
    today = time.mktime((now.tm_year, now.tm_mon, now.tm_mday, 0, 0, 0, 0, 0, -1))
    days_left = max(0, int(round((reset_day - today) / 86400)))
    month_names = (
        "Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sept", "Oct", "Nov", "Dec",
    )
    month = month_names[reset.tm_mon - 1]
    day = str(reset.tm_mday)
    if days_left == 0:
        tail = "resets today"
    elif days_left == 1:
        tail = "1 day left"
    else:
        tail = f"{days_left} days left"
    return f"Resets {day} {month} ({tail})"


def _usage_limit_percent(limit: dict) -> float | None:
    try:
        percent = float(limit.get("percent"))
    except (TypeError, ValueError):
        return None
    if percent != percent:
        return None
    if percent > 1:
        percent /= 100.0
    return min(1.0, max(0.0, percent))


def _usage_panel_limit(
    label: str,
    percent: float | None,
    *,
    bar_style: str = "accent",
    caption: str = "",
    resets_at: Any = None,
) -> dict:
    entry: dict[str, Any] = {
        "label": label,
        "title": label,
        "barStyle": bar_style,
        "caption": caption,
    }
    if percent is not None:
        entry["percent"] = percent
    reset = str(resets_at or "").strip()
    if reset:
        entry["resetsAt"] = reset
        reset_caption = _usage_reset_caption(reset)
        if reset_caption:
            entry["resetCaption"] = reset_caption
    return entry


def _usage_pick_limit(limits: list[dict], *needles: str) -> dict | None:
    for entry in limits:
        hay = " ".join(
            str(entry.get(key) or "")
            for key in ("label", "title", "kind", "period")
        ).lower()
        if any(needle in hay for needle in needles):
            return entry
    return None


def _usage_cursor_panel_limits(limits: list[dict]) -> list[dict]:
    cursor_entry = _usage_pick_limit(limits, "cursor model", "auto", "included")
    other_entry = _usage_pick_limit(limits, "other model", "api")
    if cursor_entry is None and limits:
        cursor_entry = limits[0]
    if other_entry is None and len(limits) > 1:
        other_entry = limits[1]

    rows: list[dict] = []
    cursor_percent = _usage_limit_percent(cursor_entry) if cursor_entry else None
    if cursor_entry is not None and cursor_percent is not None:
        rows.append(
            _usage_panel_limit(
                "Cursor Models · Includes Cursor Grok and Composer",
                cursor_percent,
                bar_style="accent",
                caption=(
                    "Additional usage beyond limits consumes Other Models quota "
                    "or on-demand spend."
                ),
                resets_at=cursor_entry.get("resetsAt"),
            )
        )
    other_percent = _usage_limit_percent(other_entry) if other_entry else None
    if other_entry is not None and other_percent is not None:
        rows.append(
            _usage_panel_limit(
                "Other Models",
                other_percent,
                bar_style="muted",
                caption="Additional usage beyond limits consumes on-demand spend.",
                resets_at=other_entry.get("resetsAt"),
            )
        )
    return rows


def _usage_grokbot_panel_limits(limits: list[dict]) -> list[dict]:
    weekly = _usage_pick_limit(limits, "week", "bot", "grok bot") or (limits[0] if limits else None)
    if weekly is None:
        return []
    percent = _usage_limit_percent(weekly)
    if percent is None:
        return []
    return [
        _usage_panel_limit(
            "Weekly usage",
            percent,
            bar_style="accent",
            resets_at=weekly.get("resetsAt"),
        )
    ]


def _usage_grok_build_panel_limits(limits: list[dict]) -> list[dict]:
    build = (
        _usage_pick_limit(limits, "grok build", "build")
        or _usage_pick_limit(limits, "week", "month", "usage", "limit")
        or (limits[0] if limits else None)
    )
    if build is None:
        return []
    percent = _usage_limit_percent(build)
    if percent is None:
        return []
    label = str(build.get("title") or build.get("label") or "Usage").strip()
    if label.lower().endswith(" limit"):
        label = label[:-6].strip() or "Usage"
    return [
        _usage_panel_limit(
            label,
            percent,
            bar_style="accent",
            resets_at=build.get("resetsAt"),
        )
    ]


def _usage_grokbot_overlay_limits() -> list[dict]:
    overlay_path = Path.home() / ".config" / "omarchy" / "agents" / "grok.json"
    if not overlay_path.is_file():
        return []
    try:
        overlay = json.loads(overlay_path.read_text(encoding="utf-8"))
    except Exception:
        return []
    if not isinstance(overlay, dict):
        return []
    bot_pct = overlay.get("bot_pct")
    if bot_pct is None:
        return []
    try:
        percent = float(bot_pct)
    except (TypeError, ValueError):
        return []
    if percent > 1:
        percent /= 100.0
    return [
        _usage_panel_limit(
            "Weekly usage",
            min(1.0, max(0.0, percent)),
            bar_style="accent",
            resets_at=overlay.get("bot_reset_at"),
        )
    ]


def _usage_panel_limits(agent_id: str, limits: list[dict]) -> list[dict]:
    if agent_id == "cursor":
        return _usage_cursor_panel_limits(limits)
    if agent_id == "grokbot":
        rows = _usage_grokbot_panel_limits(limits)
        return rows if rows else _usage_grokbot_overlay_limits()
    if agent_id == "grok":
        return _usage_grok_build_panel_limits(limits)
    return limits


def _usage_normalize_auth_help(agent_id: str, record: dict) -> tuple[str, str]:
    usage_status = str(record.get("usageStatusText") or "").strip()
    auth_help = str(record.get("authHelpText") or "").strip()
    if auth_help.lower() == "initialize":
        if agent_id == "grokbot":
            auth_help = (
                "Sign in to Grok Bot on this laptop, then refresh "
                "(or `omarchy agent usage-update grokbot`)."
            )
        elif agent_id == "grok":
            auth_help = "Run `grok login`, then refresh (or `omarchy agent usage-update grok`)."
        else:
            auth_help = "Sign in to Cursor on this laptop, then refresh."
    if agent_id == "grokbot" and "limits unavailable" in usage_status.lower():
        if not auth_help or auth_help.lower() == "initialize":
            auth_help = (
                "Sign in to Grok Bot to refresh weekly limits; "
                "local stats may still apply."
            )
    if agent_id == "grok" and "limits unavailable" in usage_status.lower():
        if not auth_help or auth_help.lower() == "initialize":
            auth_help = "Run `grok login` to refresh build limits; local stats may still apply."
    return usage_status, auth_help


def _usage_panel_agent(agent_id: str, record: dict | None) -> dict:
    if record is None:
        status, help_text = USAGE_MISSING_HELP.get(
            agent_id, ("No usage data yet", "Open the panel again to collect usage.")
        )
        return {
            "id": agent_id,
            "name": AGENT_USAGE_NAMES.get(agent_id, agent_id),
            "available": False,
            "ready": False,
            "tierLabel": "",
            "usageStatusText": status,
            "authHelpText": help_text,
            "todayTotalTokens": 0,
            "todayPrompts": 0,
            "limits": [],
            "updatedAt": _usage_now_iso(),
        }

    limits = record.get("limits") if isinstance(record.get("limits"), list) else []
    panel_limits = _usage_panel_limits(agent_id, limits)
    usage_status, auth_help = _usage_normalize_auth_help(agent_id, record)
    ready = record.get("ready") is True
    has_stats = record.get("hasLocalStats") is True or bool(record.get("modelUsage"))
    has_tokens = _usage_number(record.get("todayTotalTokens")) > 0
    has_prompts = _usage_number(record.get("todayPrompts")) > 0
    has_limits = bool(panel_limits)
    has_tier = bool(str(record.get("tierLabel") or "").strip())
    available = ready or has_stats or has_limits or has_tier or has_tokens or has_prompts
    return {
        "id": agent_id,
        "name": str(record.get("name") or AGENT_USAGE_NAMES.get(agent_id, agent_id)),
        "available": available,
        "ready": ready,
        "tierLabel": str(record.get("tierLabel") or ""),
        "usageStatusText": usage_status,
        "authHelpText": auth_help,
        "todayTotalTokens": _usage_number(record.get("todayTotalTokens")),
        "todayPrompts": _usage_number(record.get("todayPrompts")),
        "limits": panel_limits,
        "updatedAt": str(record.get("updatedAt") or _usage_now_iso()),
    }


def cmd_ai_usage(refresh: bool = False) -> int:
    missing = any(_usage_read_record(agent_id) is None for agent_id in AGENT_USAGE_IDS)
    if refresh or missing:
        cmd_ai_usage_update()
    agents = [_usage_panel_agent(agent_id, _usage_read_record(agent_id)) for agent_id in AGENT_USAGE_IDS]
    print(json.dumps({"agents": agents, "updatedAt": _usage_now_iso()}, separators=(",", ":")))
    return 0


def cmd_ai_usage_update() -> int:
    USAGE_STATE_DIR.mkdir(parents=True, exist_ok=True)

    omarchy_err = _usage_run_omarchy_update(("grokbot",))
    if omarchy_err:
        _usage_run_omarchy_update(("codex",))

    grokbot_ok, grokbot_err = _usage_run_collector("grokbot")
    if not grokbot_ok and _usage_read_record("grokbot") is None:
        record = _usage_base_record("grokbot")
        record["usageStatusText"] = "Grok Bot usage unavailable"
        hint = grokbot_err or omarchy_err
        record["authHelpText"] = (
            "Sign in to Grok Bot on this laptop, then refresh "
            "(or `omarchy agent usage-update grokbot`)."
            + (f" ({hint})" if hint else "")
        )
        _usage_write_record("grokbot", record)

    for agent_id, local_collector in (
        ("cursor", _usage_collect_cursor_local),
        ("grok", _usage_collect_grok_local),
    ):
        ext_ok, _ = _usage_run_collector(agent_id)
        if not ext_ok:
            _usage_write_record(agent_id, local_collector())

    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Omarchy Task Manager stats backend")
    parser.add_argument("--version", action="version", version=APP_VERSION)
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("snapshot", help="Emit JSON stats snapshot")
    kill_p = sub.add_parser("kill", help="Terminate a process (SIGTERM then SIGKILL)")
    kill_p.add_argument("pid", type=int)

    sub.add_parser("prefs-get", help="Print prefs.json")
    prefs_set = sub.add_parser("prefs-set", help="Update one prefs.json key")
    prefs_set.add_argument("key")
    prefs_set.add_argument("value")

    sub.add_parser("autostart-get", help="Print autostart.lua enabled state")
    autostart_set = sub.add_parser("autostart-set", help="Enable/disable Hyprland autostart block")
    autostart_set.add_argument("value")

    ai_usage = sub.add_parser(
        "ai-usage",
        help="Emit aggregated AI usage JSON for Cursor, Grok Bot, and Grok build",
    )
    ai_usage.add_argument(
        "--refresh",
        action="store_true",
        help="Run ai-usage-update before reading state files",
    )
    sub.add_parser("ai-usage-update", help="Refresh AI usage state files (no Grok API calls)")

    args = parser.parse_args(argv)
    if args.command == "snapshot":
        return cmd_snapshot()
    if args.command == "kill":
        return cmd_kill(args.pid)
    if args.command == "prefs-get":
        return cmd_prefs_get()
    if args.command == "prefs-set":
        return cmd_prefs_set(args.key, args.value)
    if args.command == "autostart-get":
        return cmd_autostart_get()
    if args.command == "autostart-set":
        return cmd_autostart_set(args.value)
    if args.command == "ai-usage":
        return cmd_ai_usage(refresh=args.refresh)
    if args.command == "ai-usage-update":
        return cmd_ai_usage_update()

    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
