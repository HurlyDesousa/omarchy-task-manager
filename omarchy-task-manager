def _provider_load(provider: Gtk.CssProvider, css: str) -> None:
    if hasattr(provider, "load_from_string"):
        provider.load_from_string(css)
        return
    data = css.encode("utf-8")
    try:
        provider.load_from_data(data)
    except TypeError:
        provider.load_from_data(data, len(data))


_THEME_PROVIDER: Gtk.CssProvider | None = None


def apply_theme() -> None:
    global _THEME_PROVIDER
    bg, fg, accent = load_theme_colors()
    css = build_css(bg, fg, accent)
    if _THEME_PROVIDER is None:
        _THEME_PROVIDER = Gtk.CssProvider()
    try:
        _provider_load(_THEME_PROVIDER, css)
    except Exception:
        _provider_load(_THEME_PROVIDER, build_css(FALLBACK_BG, FALLBACK_FG, FALLBACK_FG))
    display = Gdk.Display.get_default()
    if display is None:
        return
    Gtk.StyleContext.add_provider_for_display(
        display, _THEME_PROVIDER, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )


def _file_monitor_flags() -> Gio.FileMonitorFlags:
    flags = Gio.FileMonitorFlags.NONE
    if hasattr(Gio.FileMonitorFlags, "WATCH_MOVES"):
        flags |= Gio.FileMonitorFlags.WATCH_MOVES
    return flags


def watch_theme_dir(on_change) -> list[Gio.FileMonitor]:
    """Watch Omarchy state/theme paths; on_change runs on the main loop.

    Monitors the whole state directory so atomic current/ symlink swaps
    (theme changes) are caught, in addition to the live theme directory.
    """
    flags = _file_monitor_flags()
    monitors: list[Gio.FileMonitor] = []
    seen: set[str] = set()
    candidates = [
        Path.home() / ".local" / "state" / "omarchy",
        THEME_DIR.parent,
        THEME_DIR,
    ]

    def _changed(*_args) -> None:
        GLib.idle_add(on_change)

    for path in candidates:
        try:
            if not path.is_dir() and not path.is_symlink():
                continue
            key = str(path.resolve() if path.is_symlink() else path)
            if key in seen:
                continue
            seen.add(key)
        except OSError:
            continue
        gfile = Gio.File.new_for_path(str(path))
        try:
            monitor = gfile.monitor_directory(flags, None)
        except (GLib.Error, TypeError, AttributeError):
            try:
                monitor = gfile.monitor(flags, None)
            except Exception:
                continue
        monitor.connect("changed", _changed)
        monitors.append(monitor)
    return monitors


