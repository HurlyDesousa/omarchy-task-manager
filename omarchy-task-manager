def load_prefs() -> dict:
    prefs = dict(DEFAULT_PREFS)
    try:
        data = json.loads(PREFS_FILE.read_text(encoding="utf-8"))
        for key, default in DEFAULT_PREFS.items():
            val = data.get(key, default)
            if type(val) is type(default):
                prefs[key] = val
    except Exception:
        pass
    return prefs


def save_prefs(prefs: dict) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        PREFS_FILE.write_text(json.dumps(prefs, indent=2) + "\n", encoding="utf-8")
    except Exception:
        pass


def _read_autostart_enabled() -> bool:
    """Return True if the marked block in autostart.lua has an active o.launch_on_start line."""
    try:
        text = AUTOSTART_LUA.read_text(encoding="utf-8")
    except OSError:
        return False
    i_begin = text.find(AUTOSTART_BLOCK_BEGIN)
    if i_begin < 0:
        return False
    i_end = text.find(AUTOSTART_BLOCK_END, i_begin)
    if i_end < 0:
        return False
    block = text[i_begin:i_end]
    return bool(re.search(r"o\.launch_on_start\s*\(", block))


def _set_autostart(enabled: bool) -> str:
    """Enable or disable autostart in autostart.lua.

    Enabling: writes (or replaces) the marked block with o.launch_on_start +
    float-only o.window rule — no size, move, pin, or position rules.
    Disabling: removes the marked block entirely.
    Returns '' on success or an error description.
    """
    try:
        try:
            text = AUTOSTART_LUA.read_text(encoding="utf-8")
        except FileNotFoundError:
            text = "-- Extra autostart processes.\n"

        i_begin = text.find(AUTOSTART_BLOCK_BEGIN)
        i_end = (
            text.find(AUTOSTART_BLOCK_END, i_begin) if i_begin >= 0 else -1
        )
        has_block = i_begin >= 0 and i_end >= 0

        if enabled:
            launch_line = f'o.launch_on_start("{APP_BINARY}")'
            window_line = f'o.window("{APP_ID}", {{ float = true }})'
            new_block = (
                f"{AUTOSTART_BLOCK_BEGIN}\n"
                f"{launch_line}\n"
                f"{window_line}\n"
                f"{AUTOSTART_BLOCK_END}\n"
            )
            if has_block:
                block_inner = text[i_begin + len(AUTOSTART_BLOCK_BEGIN) : i_end]
                # Skip rewrite only when block is already canonical float-only.
                _window_re = re.compile(
                    r'o\.window\s*\(\s*["\']' + re.escape(APP_ID) + r'["\']'
                )
                if (
                    re.search(r"o\.launch_on_start\s*\(", block_inner)
                    and _window_re.search(block_inner)
                    and not re.search(r"\bmove\s*=", block_inner)
                    and not re.search(r"\bsize\s*=", block_inner)
                    and not re.search(r"\bpin\s*=", block_inner)
                ):
                    return ""  # already canonical; nothing to write
                # Replace stale block (may have old size/move rules or missing float).
                before = text[:i_begin].rstrip("\n") + "\n"
                after = text[i_end + len(AUTOSTART_BLOCK_END) :].lstrip("\n")
                new_text = before + new_block + ("\n" if after else "")  + after
            else:
                new_text = text.rstrip("\n") + "\n\n" + new_block
        else:
            if not has_block:
                return ""  # nothing to change
            # Remove the entire marked block when disabling.
            new_text = (
                text[:i_begin].rstrip("\n")
                + "\n"
                + text[i_end + len(AUTOSTART_BLOCK_END) :].lstrip("\n")
            )

        AUTOSTART_LUA.parent.mkdir(parents=True, exist_ok=True)
        AUTOSTART_LUA.write_text(new_text, encoding="utf-8")
        return ""
    except OSError as exc:
        return str(exc)


