def _run_cmd(argv: list[str]) -> str | None:
    """Run argv; return combined stdout+stderr or None on timeout/not-found."""
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    try:
        proc = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=FAN_TIMEOUT,
            check=False,
            stdin=subprocess.DEVNULL,
            env=env,
        )
    except FileNotFoundError:
        return None
    except (subprocess.TimeoutExpired, OSError):
        return None
    except Exception:
        return None
    return ((proc.stdout or "") + "\n" + (proc.stderr or "")).strip()


def _parse_fan_text(output: str | None) -> tuple[int | None, int | None] | None:
    if not output:
        return None
    left_m = LEFT_FAN_RE.search(output)
    right_m = RIGHT_FAN_RE.search(output)
    if left_m is None and right_m is None:
        return None
    left = int(left_m.group(1)) if left_m else None
    right = int(right_m.group(1)) if right_m else None
    return left, right


def _hwmon_fan_speeds() -> tuple[int | None, int | None]:
    """Last-resort: first two fan*_input nodes under /sys/class/hwmon."""
    base = Path("/sys/class/hwmon")
    try:
        hwmons = sorted(base.iterdir())
    except OSError:
        return None, None
    rpms: list[int] = []
    for hw in hwmons:
        for node in sorted(hw.glob("fan*_input")):
            try:
                raw = int(node.read_text(encoding="utf-8").strip())
            except (OSError, ValueError):
                continue
            if raw > 0:
                rpms.append(raw)
            if len(rpms) >= 2:
                return rpms[0], rpms[1]
    if not rpms:
        return None, None
    if len(rpms) == 1:
        return rpms[0], None
    return rpms[0], rpms[1]


def _fan_executable() -> str | None:
    if os.path.isfile(FAN_BIN_PRIMARY):
        return FAN_BIN_PRIMARY
    return shutil.which("x1e-ec-tool")


def _fan_exec(exe: str, args: list[str]) -> str | None:
    """Try exe directly, then sudo -n. Returns output or None."""
    out = _run_cmd([exe] + args)
    if out is not None:
        return out
    sudo = shutil.which("sudo")
    if sudo:
        out = _run_cmd([sudo, "-n", exe] + args)
        if out is not None:
            return out
    return None


def read_fan_speeds() -> tuple[int | None, int | None]:
    """x1e-ec-tool get-speed → sudo -n → hwmon fallback. Never raises."""
    exe = _fan_executable()
    if exe:
        parsed = _parse_fan_text(_fan_exec(exe, ["get-speed"]))
        if parsed is not None:
            return parsed
    return _hwmon_fan_speeds()


def fmt_rpm(rpm: int | None) -> str:
    return EM_DASH if rpm is None else f"{rpm} RPM"


def apply_fan_profile_sync(profile_name: str) -> str:
    """Apply a fan profile. Run in a worker thread; returns a status string.

    Battery saver / Performance / Full speed: mode manual + set-speed <rpm>.
    Balance: mode auto only (ec-service temp-loop owns RPM; no set-speed).
    Never calls `profile`, `profile get`, or `get-profile`.
    Does not stop x1e-ec-tool.service.
    """
    entry = next((p for p in FAN_PROFILES if p[0] == profile_name), None)
    if entry is None:
        return f"\u26a0 Unknown profile: {profile_name}"

    _, mode, rpm = entry
    exe = _fan_executable()
    if exe is None:
        return "\u26a0 x1e-ec-tool not found"

    out = _fan_exec(exe, ["mode", mode])
    if out is None:
        return f"\u26a0 Failed: mode {mode}"

    if rpm is not None:
        out = _fan_exec(exe, ["set-speed", str(rpm)])
        if out is None:
            return f"\u26a0 Failed: set-speed {rpm}"

    # Verify: show actual RPM from get-speed (may still be ramping up)
    speed_out = _fan_exec(exe, ["get-speed"])
    parsed = _parse_fan_text(speed_out)
    if parsed is not None:
        left, right = parsed
        parts: list[str] = []
        if left is not None:
            parts.append(f"L {left} RPM")
        if right is not None:
            parts.append(f"R {right} RPM")
        if parts:
            return f"{profile_name}: {', '.join(parts)}"

    return f"{profile_name} applied"


def _interpolate_rpm(curve: list[tuple[float, int]], temp: float) -> int:
    """Linearly interpolate RPM from (temp, rpm) anchor points."""
    if temp <= curve[0][0]:
        return curve[0][1]
    if temp >= curve[-1][0]:
        return curve[-1][1]
    for i in range(len(curve) - 1):
        t0, r0 = curve[i]
        t1, r1 = curve[i + 1]
        if t0 <= temp <= t1:
            frac = (temp - t0) / (t1 - t0)
            return int(r0 + frac * (r1 - r0))
    return curve[-1][1]


