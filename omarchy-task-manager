def _primary_monitor_geometry() -> tuple[int, int, int, int] | None:
    try:
        display = Gdk.Display.get_default()
        if display is None:
            return None
        monitors = display.get_monitors()
        if monitors.get_n_items() <= 0:
            return None
        geo = monitors.get_item(0).get_geometry()
        return geo.x, geo.y, geo.width, geo.height
    except Exception:
        return None


def quarter_monitor_size() -> tuple[int, int]:
    """50 % wide × 25 % tall — the compact footprint."""
    geo = _primary_monitor_geometry()
    if geo is None:
        return 960, 270
    _, _, mw, mh = geo
    return max(480, int(mw * 0.5)), max(180, int(mh * 0.25))


def expanded_monitor_size() -> tuple[int, int]:
    """50 % wide × 50 % tall — the expanded footprint."""
    geo = _primary_monitor_geometry()
    if geo is None:
        return 960, 540
    _, _, mw, mh = geo
    return max(640, int(mw * 0.5)), max(400, int(mh * 0.5))


