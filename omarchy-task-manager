def _provider_load(provider: Gtk.CssProvider, css: str) -> None:
    if hasattr(provider, "load_from_string"):
        provider.load_from_string(css)
        return
    data = css.encode("utf-8")
    try:
        provider.load_from_data(data)
    except TypeError:
        provider.load_from_data(data, len(data))


def apply_theme() -> None:
    bg, fg, accent = load_theme_colors()
    css = build_css(bg, fg, accent)
    provider = Gtk.CssProvider()
    try:
        _provider_load(provider, css)
    except Exception:
        _provider_load(provider, build_css(FALLBACK_BG, FALLBACK_FG, FALLBACK_FG))
    display = Gdk.Display.get_default()
    if display is None:
        return
    Gtk.StyleContext.add_provider_for_display(
        display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )


def _add_css_class(widget: Gtk.Widget, name: str) -> None:
    if hasattr(widget, "add_css_class"):
        widget.add_css_class(name)
    else:
        widget.get_style_context().add_class(name)


def cpu_pct(prev: tuple[int, int] | None, cur: tuple[int, int]) -> float:
    if prev is None:
        return 0.0
    d_busy = cur[0] - prev[0]
    d_idle = cur[1] - prev[1]
    total = d_busy + d_idle
    if total <= 0:
        return 0.0
    return max(0.0, min(100.0, 100.0 * d_busy / total))


def read_proc_stat() -> tuple[tuple[int, int] | None, dict[int, tuple[int, int]]]:
    """overall (busy, idle) plus cpuN index -> (busy, idle). Core count is not hardcoded."""
    overall = None
    cores: dict[int, tuple[int, int]] = {}
    try:
        with open("/proc/stat", encoding="utf-8") as fh:
            lines = fh.readlines()
    except OSError:
        return None, {}
    for line in lines:
        if not line.startswith("cpu"):
            continue
        parts = line.split()
        if len(parts) < 5:
            continue
        try:
            nums = [int(x) for x in parts[1:]]
        except ValueError:
            continue
        while len(nums) < 7:
            nums.append(0)
        user, nice, system, idle, iowait, irq, softirq = nums[:7]
        busy = user + nice + system + irq + softirq
        idle_all = idle + iowait
        sample = (busy, idle_all)
        name = parts[0]
        if name == "cpu":
            overall = sample
        elif name.startswith("cpu") and name[3:].isdigit():
            cores[int(name[3:])] = sample
    return overall, cores


def read_cpu_temp() -> float | None:
    base = Path("/sys/class/thermal")
    try:
        zones = list(base.iterdir())
    except OSError:
        return None
    preferred: list[float] = []
    cpu_named: list[float] = []
    for zone in zones:
        if not zone.name.startswith("thermal_zone"):
            continue
        try:
            ztype = (zone / "type").read_text(encoding="utf-8").strip()
            millideg = int((zone / "temp").read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            continue
        celsius = millideg / 1000.0
        if ztype in PREFERRED_THERMAL:
            preferred.append(celsius)
        elif ztype.startswith("cpu"):
            cpu_named.append(celsius)
    if preferred:
        return max(preferred)
    if cpu_named:
        return max(cpu_named)
    return None


def _run_fan_tool(argv0: str) -> str | None:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    try:
        proc = subprocess.run(
            [argv0, "get-speed"],
            capture_output=True,
            text=True,
            timeout=FAN_TIMEOUT,
            check=False,
            stdin=subprocess.DEVNULL,
            env=env,
        )
    except FileNotFoundError:
        return None
    except (subprocess.TimeoutExpired, OSError):
        return None
    except Exception:
        return None
    if proc.returncode != 0:
        return None
    return proc.stdout or ""


def read_fan_speeds() -> tuple[int | None, int | None]:
    """Parse `Left Fan: N RPM` / `Right Fan: N RPM`. Never raises."""
    candidates: list[str] = []
    if os.path.isfile(FAN_BIN_PRIMARY) and os.access(FAN_BIN_PRIMARY, os.X_OK):
        candidates.append(FAN_BIN_PRIMARY)
    fallback = shutil.which("x1e-ec-tool")
    if fallback and fallback not in candidates:
        candidates.append(fallback)
    for exe in candidates:
        output = _run_fan_tool(exe)
        if not output:
            continue
        left_m = LEFT_FAN_RE.search(output)
        right_m = RIGHT_FAN_RE.search(output)
        if left_m is None and right_m is None:
            continue
        left = int(left_m.group(1)) if left_m else None
        right = int(right_m.group(1)) if right_m else None
        return left, right
    return None, None


def fmt_rpm(rpm: int | None) -> str:
    if rpm is None:
        return EM_DASH
    return f"{rpm} RPM"


def fmt_bytes(num: int) -> str:
    value = float(num)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if value < 1024.0 or unit == "TiB":
            if unit == "B":
                return f"{int(value)} {unit}"
            return f"{value:.1f} {unit}"
        value /= 1024.0
    return f"{num} B"


def _comm_from_stat(stat: str) -> tuple[str, list[str]] | None:
    left = stat.find("(")
    right = stat.rfind(")")
    if left < 0 or right < left:
        return None
    comm = stat[left + 1 : right]
    rest = stat[right + 1 :].split()
    return comm, rest


def _process_name(pid: int, comm: str) -> str:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            raw = fh.read()
    except OSError:
        return comm
    if not raw or raw == b"\x00":
        return comm
    argv = [part.decode("utf-8", "replace") for part in raw.split(b"\x00") if part]
    if not argv:
        return comm
    base = os.path.basename(argv[0])
    if base.startswith("python") and len(argv) > 1 and not argv[1].startswith("-"):
        return os.path.basename(argv[1])
    return base or comm


def _rss_bytes(pid: int, rest: list[str]) -> int:
    try:
        with open(f"/proc/{pid}/status", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    try:
        with open(f"/proc/{pid}/statm", encoding="utf-8", errors="replace") as fh:
            fields = fh.read().split()
        if len(fields) >= 2:
            return int(fields[1]) * PAGE_SIZE
    except (OSError, ValueError):
        pass
    if len(rest) >= 22:
        try:
            return int(rest[21]) * PAGE_SIZE
        except ValueError:
            return 0
    return 0


def iter_processes() -> list[tuple[int, str, int, int, int]]:
    """Return (pid, name, cpu_jiffies, rss_bytes, starttime). Skip EACCES quietly."""
    results: list[tuple[int, str, int, int, int]] = []
    try:
        names = os.listdir("/proc")
    except OSError:
        return results
    for name in names:
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as fh:
                stat = fh.read()
        except OSError:
            continue
        parsed = _comm_from_stat(stat)
        if parsed is None:
            continue
        comm, rest = parsed
        if len(rest) < 20:
            continue
        try:
            utime = int(rest[11])
            stime = int(rest[12])
            starttime = int(rest[19])
        except ValueError:
            continue
        rss = _rss_bytes(pid, rest)
        results.append((pid, _process_name(pid, comm), utime + stime, rss, starttime))
    return results


def pid_alive(pid: int, starttime: int | None = None) -> bool:
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as fh:
            stat = fh.read()
    except OSError:
        return False
    parsed = _comm_from_stat(stat)
    if parsed is None:
        return False
    if starttime is None:
        return True
    rest = parsed[1]
    if len(rest) < 20:
        return True
    try:
        return int(rest[19]) == starttime
    except ValueError:
        return True


class ConfirmDialog(Gtk.Window):
    def __init__(
        self,
        parent: Gtk.Window,
        heading: str,
        body: str,
        accept_label: str,
        on_result,
    ) -> None:
        super().__init__(title=APP_TITLE, transient_for=parent, modal=True)
        self.set_default_size(440, 150)
        self.set_resizable(False)
        self._on_result = on_result
        self._decided = False

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        root.set_margin_top(14)
        root.set_margin_bottom(14)
        root.set_margin_start(16)
        root.set_margin_end(16)

        title = Gtk.Label(label=heading, xalign=0, wrap=True)
        _add_css_class(title, "stat-value")
        body_l = Gtk.Label(label=body, xalign=0, wrap=True)
        _add_css_class(body_l, "dim")

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        buttons.set_halign(Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        accept = Gtk.Button(label=accept_label)
        cancel.connect("clicked", self._cancel)
        accept.connect("clicked", self._accept)
        buttons.append(cancel)
        buttons.append(accept)

        root.append(title)
        root.append(body_l)
        root.append(buttons)
        self.set_child(root)
        self.connect("close-request", self._on_close)

    def _finish(self, accepted: bool) -> None:
        if self._decided:
            return
        self._decided = True
        cb = self._on_result
        self.destroy()
        if cb is not None:
            cb(accepted)

    def _cancel(self, *_args) -> None:
        self._finish(False)

    def _accept(self, *_args) -> None:
        self._finish(True)

    def _on_close(self, *_args) -> bool:
        self._finish(False)
        return True


