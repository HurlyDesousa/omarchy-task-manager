#!/usr/bin/env python3
"""Omarchy Task Manager — stats backend for the Quickshell KeyboardPanel."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

APP_VERSION = "0.5.5-21"
EM_DASH = "\u2014"

PREFERRED_THERMAL = (
    "cpu0-0-top-thermal",
    "cpu1-0-top-thermal",
    "cpu2-0-top-thermal",
)

GPU_DEVFREQ = Path("/sys/class/devfreq/3d00000.gpu")
_GPU_THERMAL_RE = re.compile(r"^gpuss_\d+_thermal$")

FAN_BIN_PRIMARY = "/usr/local/bin/x1e-ec-tool"
FAN_TIMEOUT = 2.0
FAN_RPM_MAX = 8000

STATE_DIR = Path.home() / ".local" / "state" / "omarchy" / "task-manager"
PREFS_FILE = STATE_DIR / "prefs.json"
STATS_STATE_FILE = STATE_DIR / "stats-state.json"

APP_BINARY = str(Path.home() / ".local" / "bin" / "omarchy-task-manager")
AUTOSTART_LUA = Path.home() / ".config" / "hypr" / "autostart.lua"
AUTOSTART_BLOCK_BEGIN = "-- omarchy-task-manager begin"
AUTOSTART_BLOCK_END = "-- omarchy-task-manager end"
APP_ID = "art.sw.omarchy.TaskManager"

DEFAULT_PREFS: dict = {
    "start_compact": False,
    "remember_expand": True,
    "refresh_ms": 1000,
    "last_compact": True,
}

LEFT_FAN_RE = re.compile(r"Left Fan:\s*(\d+)\s*RPM", re.IGNORECASE)
RIGHT_FAN_RE = re.compile(r"Right Fan:\s*(\d+)\s*RPM", re.IGNORECASE)

try:
    PAGE_SIZE = int(os.sysconf("SC_PAGE_SIZE"))
except (OSError, ValueError):
    PAGE_SIZE = 4096


def load_prefs() -> dict:
    prefs = dict(DEFAULT_PREFS)
    try:
        data = json.loads(PREFS_FILE.read_text(encoding="utf-8"))
        for key, default in DEFAULT_PREFS.items():
            val = data.get(key, default)
            if type(val) is type(default):
                prefs[key] = val
    except Exception:
        pass
    return prefs


def save_prefs(prefs: dict) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        PREFS_FILE.write_text(json.dumps(prefs, indent=2) + "\n", encoding="utf-8")
    except Exception:
        pass


def load_stats_state() -> dict:
    try:
        return json.loads(STATS_STATE_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {}


def save_stats_state(state: dict) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        STATS_STATE_FILE.write_text(json.dumps(state) + "\n", encoding="utf-8")
    except Exception:
        pass


def _read_autostart_enabled() -> bool:
    try:
        text = AUTOSTART_LUA.read_text(encoding="utf-8")
    except OSError:
        return False
    i_begin = text.find(AUTOSTART_BLOCK_BEGIN)
    if i_begin < 0:
        return False
    i_end = text.find(AUTOSTART_BLOCK_END, i_begin)
    if i_end < 0:
        return False
    block = text[i_begin:i_end]
    return bool(re.search(r"o\.launch_on_start\s*\(", block))


def _set_autostart(enabled: bool) -> str:
    try:
        try:
            text = AUTOSTART_LUA.read_text(encoding="utf-8")
        except FileNotFoundError:
            text = "-- Extra autostart processes.\n"

        i_begin = text.find(AUTOSTART_BLOCK_BEGIN)
        i_end = text.find(AUTOSTART_BLOCK_END, i_begin) if i_begin >= 0 else -1
        has_block = i_begin >= 0 and i_end >= 0

        if enabled:
            launch_line = f'o.launch_on_start("{APP_BINARY}")'
            window_line = f'o.window("{APP_ID}", {{ float = true }})'
            new_block = (
                f"{AUTOSTART_BLOCK_BEGIN}\n"
                f"{launch_line}\n"
                f"{window_line}\n"
                f"{AUTOSTART_BLOCK_END}\n"
            )
            if has_block:
                block_inner = text[i_begin + len(AUTOSTART_BLOCK_BEGIN) : i_end]
                _window_re = re.compile(
                    r'o\.window\s*\(\s*["\']' + re.escape(APP_ID) + r'["\']'
                )
                if (
                    re.search(r"o\.launch_on_start\s*\(", block_inner)
                    and _window_re.search(block_inner)
                ):
                    return ""
                text = text[:i_begin] + new_block + text[i_end + len(AUTOSTART_BLOCK_END) + 1 :]
            else:
                text = text.rstrip() + "\n\n" + new_block
        elif has_block:
            text = text[:i_begin] + text[i_end + len(AUTOSTART_BLOCK_END) + 1 :]

        AUTOSTART_LUA.parent.mkdir(parents=True, exist_ok=True)
        AUTOSTART_LUA.write_text(text, encoding="utf-8")
        return ""
    except Exception as exc:
        return str(exc)


def cpu_pct(prev: tuple[int, int] | None, cur: tuple[int, int]) -> float:
    if prev is None:
        return 0.0
    d_busy = cur[0] - prev[0]
    d_idle = cur[1] - prev[1]
    total = d_busy + d_idle
    if total <= 0:
        return 0.0
    return max(0.0, min(100.0, 100.0 * d_busy / total))


def read_proc_stat() -> tuple[tuple[int, int] | None, dict[int, tuple[int, int]]]:
    overall = None
    cores: dict[int, tuple[int, int]] = {}
    try:
        with open("/proc/stat", encoding="utf-8") as fh:
            lines = fh.readlines()
    except OSError:
        return None, {}
    for line in lines:
        if not line.startswith("cpu"):
            continue
        parts = line.split()
        if len(parts) < 5:
            continue
        try:
            nums = [int(x) for x in parts[1:]]
        except ValueError:
            continue
        while len(nums) < 7:
            nums.append(0)
        user, nice, system, idle, iowait, irq, softirq = nums[:7]
        busy = user + nice + system + irq + softirq
        idle_all = idle + iowait
        sample = (busy, idle_all)
        name = parts[0]
        if name == "cpu":
            overall = sample
        elif name.startswith("cpu") and name[3:].isdigit():
            cores[int(name[3:])] = sample
    return overall, cores


def read_cpu_temp() -> float | None:
    base = Path("/sys/class/thermal")
    try:
        zones = list(base.iterdir())
    except OSError:
        return None
    preferred: list[float] = []
    cpu_named: list[float] = []
    for zone in zones:
        if not zone.name.startswith("thermal_zone"):
            continue
        try:
            ztype = (zone / "type").read_text(encoding="utf-8").strip()
            millideg = int((zone / "temp").read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            continue
        celsius = millideg / 1000.0
        if ztype in PREFERRED_THERMAL:
            preferred.append(celsius)
        elif ztype.startswith("cpu"):
            cpu_named.append(celsius)
    if preferred:
        return max(preferred)
    if cpu_named:
        return max(cpu_named)
    return None


def read_gpu_usage() -> float | None:
    try:
        cur = int((GPU_DEVFREQ / "cur_freq").read_text(encoding="utf-8").strip())
        mx = int((GPU_DEVFREQ / "max_freq").read_text(encoding="utf-8").strip())
        if mx <= 0:
            return None
        return max(0.0, min(100.0, 100.0 * cur / mx))
    except (OSError, ValueError):
        return None


def read_gpu_temp() -> float | None:
    base = Path("/sys/class/hwmon")
    try:
        hwmons = list(base.iterdir())
    except OSError:
        return None
    temps: list[float] = []
    for hw in hwmons:
        try:
            name = (hw / "name").read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if not _GPU_THERMAL_RE.match(name):
            continue
        try:
            millideg = int((hw / "temp1_input").read_text(encoding="utf-8").strip())
            temps.append(millideg / 1000.0)
        except (OSError, ValueError):
            continue
    return max(temps) if temps else None


def read_mem_usage() -> tuple[int, int, float] | None:
    total_kib: int | None = None
    avail_kib: int | None = None
    try:
        with open("/proc/meminfo", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("MemTotal:"):
                    total_kib = int(line.split()[1])
                elif line.startswith("MemAvailable:"):
                    avail_kib = int(line.split()[1])
    except (OSError, ValueError):
        return None
    if total_kib is None or avail_kib is None or total_kib <= 0:
        return None
    used_kib = max(0, total_kib - avail_kib)
    pct = max(0.0, min(100.0, 100.0 * used_kib / total_kib))
    return used_kib, total_kib, pct


def fmt_mem_gib_pair(used_kib: int, total_kib: int) -> str:
    gib = 1024 * 1024
    return f"{used_kib / gib:.1f} / {total_kib / gib:.1f} GiB"


def read_uptime() -> float | None:
    try:
        with open("/proc/uptime", encoding="utf-8") as fh:
            return float(fh.read().split()[0])
    except (OSError, ValueError, IndexError):
        return None


def fmt_uptime(seconds: float) -> str:
    total = max(0, int(seconds))
    days = total // 86400
    rem = total % 86400
    hours = rem // 3600
    minutes = (rem % 3600) // 60
    parts: list[str] = []
    if days:
        parts.append(f"{days}d")
    if hours:
        parts.append(f"{hours}h")
    if minutes or not parts:
        parts.append(f"{minutes}m")
    return " ".join(parts)


def _run_cmd(argv: list[str]) -> str | None:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    try:
        proc = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=FAN_TIMEOUT,
            check=False,
            stdin=subprocess.DEVNULL,
            env=env,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return None
    return ((proc.stdout or "") + "\n" + (proc.stderr or "")).strip()


def _parse_fan_text(output: str | None) -> tuple[int | None, int | None] | None:
    if not output:
        return None
    left_m = LEFT_FAN_RE.search(output)
    right_m = RIGHT_FAN_RE.search(output)
    if left_m is None and right_m is None:
        return None
    left = int(left_m.group(1)) if left_m else None
    right = int(right_m.group(1)) if right_m else None
    return left, right


def _hwmon_fan_speeds() -> tuple[int | None, int | None]:
    base = Path("/sys/class/hwmon")
    try:
        hwmons = sorted(base.iterdir())
    except OSError:
        return None, None
    rpms: list[int] = []
    for hw in hwmons:
        for fan in sorted(hw.glob("fan*_input")):
            try:
                rpms.append(int(fan.read_text(encoding="utf-8").strip()))
            except (OSError, ValueError):
                continue
    if not rpms:
        return None, None
    left = rpms[0]
    right = rpms[1] if len(rpms) > 1 else None
    return left, right


def _fan_executable() -> str | None:
    if Path(FAN_BIN_PRIMARY).is_file():
        return FAN_BIN_PRIMARY
    return shutil.which("x1e-ec-tool")


def _fan_exec(exe: str, args: list[str]) -> str | None:
    out = _run_cmd([exe] + args)
    if out is not None:
        return out
    sudo = shutil.which("sudo")
    if sudo:
        out = _run_cmd([sudo, "-n", exe] + args)
        if out is not None:
            return out
    return None


def read_fan_speeds() -> tuple[int | None, int | None]:
    exe = _fan_executable()
    if exe:
        parsed = _parse_fan_text(_fan_exec(exe, ["get-speed"]))
        if parsed is not None:
            return parsed
    return _hwmon_fan_speeds()


def fan_meter_fraction(rpm: int | None) -> float:
    if rpm is None or rpm <= 0:
        return 0.0
    return max(0.0, min(1.0, rpm / FAN_RPM_MAX))


def fmt_fan_meter(rpm: int | None) -> str:
    if rpm is None:
        return EM_DASH
    pct = fan_meter_fraction(rpm) * 100.0
    return f"{rpm} {pct:.0f}%"


def fmt_bytes(num: int) -> str:
    value = float(num)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if value < 1024.0 or unit == "TiB":
            if unit == "B":
                return f"{int(value)} {unit}"
            return f"{value:.1f} {unit}"
        value /= 1024.0
    return f"{num} B"


def _comm_from_stat(stat: str) -> tuple[str, list[str]] | None:
    left = stat.find("(")
    right = stat.rfind(")")
    if left < 0 or right < left:
        return None
    comm = stat[left + 1 : right]
    rest = stat[right + 1 :].split()
    return comm, rest


def _process_name(pid: int, comm: str) -> str:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            raw = fh.read()
    except OSError:
        return comm
    if not raw or raw == b"\x00":
        return comm
    argv = [part.decode("utf-8", "replace") for part in raw.split(b"\x00") if part]
    if not argv:
        return comm
    base = os.path.basename(argv[0])
    if base.startswith("python") and len(argv) > 1 and not argv[1].startswith("-"):
        return os.path.basename(argv[1])
    return base or comm


def _rss_bytes(pid: int, rest: list[str]) -> int:
    try:
        with open(f"/proc/{pid}/status", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    try:
        with open(f"/proc/{pid}/statm", encoding="utf-8", errors="replace") as fh:
            fields = fh.read().split()
        if len(fields) >= 2:
            return int(fields[1]) * PAGE_SIZE
    except (OSError, ValueError):
        pass
    if len(rest) >= 22:
        try:
            return int(rest[21]) * PAGE_SIZE
        except ValueError:
            return 0
    return 0


def iter_processes() -> list[tuple[int, str, int, int, int]]:
    results: list[tuple[int, str, int, int, int]] = []
    try:
        names = os.listdir("/proc")
    except OSError:
        return results
    for name in names:
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as fh:
                stat = fh.read()
        except OSError:
            continue
        parsed = _comm_from_stat(stat)
        if parsed is None:
            continue
        comm, rest = parsed
        if len(rest) < 22:
            continue
        try:
            jiffies = int(rest[11]) + int(rest[12])
            starttime = int(rest[19])
        except ValueError:
            continue
        pname = _process_name(pid, comm)
        rss = _rss_bytes(pid, rest)
        results.append((pid, pname, jiffies, rss, starttime))
    return results


def pid_alive(pid: int, starttime: int | None = None) -> bool:
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as fh:
            stat = fh.read()
    except OSError:
        return False
    if starttime is None:
        return True
    parsed = _comm_from_stat(stat)
    if parsed is None:
        return False
    rest = parsed[1]
    if len(rest) < 20:
        return False
    try:
        return int(rest[19]) == starttime
    except ValueError:
        return False


def kill_process(pid: int) -> tuple[bool, str]:
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return False, "Process not found"
    except PermissionError:
        return False, "Permission denied"
    except OSError as exc:
        return False, str(exc)
    deadline = time.time() + 2.0
    while time.time() < deadline:
        if not pid_alive(pid):
            return True, ""
        time.sleep(0.1)
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return True, ""
    except PermissionError:
        return False, "Permission denied — could not SIGKILL"
    except OSError as exc:
        return False, str(exc)
    return True, ""


def build_snapshot() -> dict:
    state = load_stats_state()
    overall, cores = read_proc_stat()
    prev_overall = state.get("prev_overall")
    prev_overall_t = tuple(prev_overall) if isinstance(prev_overall, list) and len(prev_overall) == 2 else None
    prev_cores_raw = state.get("prev_cores", {})
    prev_cores: dict[int, tuple[int, int]] = {}
    if isinstance(prev_cores_raw, dict):
        for key, val in prev_cores_raw.items():
            if isinstance(val, list) and len(val) == 2:
                try:
                    prev_cores[int(key)] = (int(val[0]), int(val[1]))
                except (TypeError, ValueError):
                    pass

    cpu_pct_val = cpu_pct(prev_overall_t, overall) if overall else 0.0
    core_rows = []
    for idx in sorted(cores):
        cur = cores[idx]
        prev = prev_cores.get(idx)
        core_rows.append({"id": idx, "pct": round(cpu_pct(prev, cur))})

    gpu_usage = read_gpu_usage()
    gpu_temp = read_gpu_temp()
    cpu_temp = read_cpu_temp()
    mem = read_mem_usage()
    uptime = read_uptime()
    fan_left, fan_right = read_fan_speeds()

    prev_total = state.get("prev_total_jiffies")
    prev_proc_raw = state.get("prev_proc", {})
    prev_proc: dict[str, int] = {}
    if isinstance(prev_proc_raw, dict):
        for key, val in prev_proc_raw.items():
            if isinstance(val, int):
                prev_proc[str(key)] = val

    processes = []
    if overall is not None:
        total_jiffies = overall[0] + overall[1]
        ncpu = max(1, len(cores))
        d_total = (total_jiffies - prev_total) if isinstance(prev_total, int) else 0
        next_proc: dict[str, int] = {}
        for pid, name, jiffies, rss, starttime in iter_processes():
            key = f"{pid}:{starttime}"
            cpu = 0.0
            prev = prev_proc.get(key)
            if prev is not None and d_total > 0:
                cpu = max(0.0, 100.0 * (jiffies - prev) / d_total * ncpu)
            next_proc[key] = jiffies
            processes.append(
                {
                    "pid": pid,
                    "name": name,
                    "cpu": round(cpu),
                    "cpu_txt": f"{round(cpu)}",
                    "rss": rss,
                    "rss_txt": fmt_bytes(rss),
                    "starttime": starttime,
                }
            )
        processes.sort(key=lambda row: (-row["cpu"], -row["rss"], row["name"].lower()))
        state["prev_total_jiffies"] = total_jiffies
        state["prev_proc"] = next_proc
    else:
        state["prev_total_jiffies"] = None
        state["prev_proc"] = {}

    if overall is not None:
        state["prev_overall"] = [overall[0], overall[1]]
        state["prev_cores"] = {str(k): [v[0], v[1]] for k, v in cores.items()}
    save_stats_state(state)

    ram_block = None
    if mem is not None:
        used_kib, total_kib, pct = mem
        ram_block = {
            "pct": round(pct),
            "detail": fmt_mem_gib_pair(used_kib, total_kib),
        }

    def fan_block(rpm: int | None) -> dict:
        return {
            "rpm": rpm,
            "fraction": fan_meter_fraction(rpm),
            "text": fmt_fan_meter(rpm),
        }

    return {
        "version": APP_VERSION,
        "cpu": {
            "pct": round(cpu_pct_val),
            "temp": None if cpu_temp is None else round(cpu_temp, 1),
            "cores": core_rows,
        },
        "gpu": {
            "pct": None if gpu_usage is None else round(gpu_usage),
            "temp": None if gpu_temp is None else round(gpu_temp, 1),
        },
        "ram": ram_block,
        "uptime": None if uptime is None else fmt_uptime(uptime),
        "fans": {"left": fan_block(fan_left), "right": fan_block(fan_right)},
        "processes": processes,
    }


def cmd_snapshot() -> int:
    print(json.dumps(build_snapshot(), separators=(",", ":")))
    return 0


def cmd_kill(pid: int) -> int:
    ok, err = kill_process(pid)
    if ok:
        return 0
    print(err, file=sys.stderr)
    return 1


def cmd_prefs_get() -> int:
    print(json.dumps(load_prefs(), separators=(",", ":")))
    return 0


def cmd_prefs_set(key: str, value: str) -> int:
    prefs = load_prefs()
    if key not in DEFAULT_PREFS:
        print(f"Unknown pref: {key}", file=sys.stderr)
        return 1
    default = DEFAULT_PREFS[key]
    if isinstance(default, bool):
        prefs[key] = value.lower() in ("1", "true", "yes", "on")
    elif isinstance(default, int):
        try:
            prefs[key] = int(value)
        except ValueError:
            print(f"Invalid integer for {key}", file=sys.stderr)
            return 1
    else:
        prefs[key] = value
    save_prefs(prefs)
    return 0


def cmd_autostart_get() -> int:
    print("true" if _read_autostart_enabled() else "false")
    return 0


def cmd_autostart_set(value: str) -> int:
    enabled = value.lower() in ("1", "true", "yes", "on")
    err = _set_autostart(enabled)
    if err:
        print(err, file=sys.stderr)
        return 1
    return 0


# ── AI agent usage (Cursor / Codex / Grok) ───────────────────────────────────

AGENT_USAGE_IDS = ("cursor", "codex", "grok")
AGENT_USAGE_NAMES = {"cursor": "Cursor", "codex": "Codex", "grok": "Grok"}
USAGE_STATE_DIR = Path.home() / ".local" / "state" / "omarchy" / "agents" / "usage"


def _usage_now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _usage_today() -> str:
    return time.strftime("%Y-%m-%d")


def _usage_number(value) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def _usage_base_record(agent_id: str) -> dict:
    return {
        "schemaVersion": 1,
        "id": agent_id,
        "name": AGENT_USAGE_NAMES.get(agent_id, agent_id),
        "updatedAt": _usage_now_iso(),
        "ready": False,
        "hasLocalStats": False,
        "tierLabel": "",
        "usageStatusText": "unavailable",
        "authHelpText": "",
        "limits": [],
        "todayTotalTokens": 0,
        "todayPrompts": 0,
        "todaySessions": 0,
        "recentDays": [],
        "modelUsage": {},
    }


def _usage_read_record(agent_id: str) -> dict | None:
    path = USAGE_STATE_DIR / f"{agent_id}.json"
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def _usage_write_record(agent_id: str, record: dict) -> None:
    try:
        USAGE_STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = USAGE_STATE_DIR / f".{agent_id}.{os.getpid()}.tmp"
        payload = json.dumps(record, separators=(",", ":"), ensure_ascii=False)
        tmp.write_text(payload + "\n", encoding="utf-8")
        tmp.replace(USAGE_STATE_DIR / f"{agent_id}.json")
    except Exception:
        pass


def _usage_collector_paths(agent_id: str) -> list[Path]:
    names = [f"omarchy-agent-usage-{agent_id}"]
    roots = []
    omarchy_path = os.environ.get("OMARCHY_PATH")
    if omarchy_path:
        roots.append(Path(omarchy_path) / "bin")
    roots.extend(
        [
            Path("/usr/share/omarchy/bin"),
            Path.home() / ".local/share/omarchy-rs/bin",
            Path.home() / ".local/bin",
        ]
    )
    paths: list[Path] = []
    for name in names:
        found = shutil.which(name)
        if found:
            paths.append(Path(found))
        for root in roots:
            candidate = root / name
            if candidate.is_file():
                paths.append(candidate)
    # Preserve order, drop duplicates.
    seen: set[str] = set()
    unique: list[Path] = []
    for path in paths:
        key = str(path)
        if key in seen:
            continue
        seen.add(key)
        unique.append(path)
    return unique


def _usage_run_collector(agent_id: str) -> bool:
    for collector in _usage_collector_paths(agent_id):
        try:
            proc = subprocess.run(
                [str(collector)],
                capture_output=True,
                text=True,
                timeout=120,
                check=False,
            )
        except Exception:
            continue
        record = (proc.stdout or "").strip()
        if proc.returncode != 0 or not record:
            continue
        try:
            parsed = json.loads(record)
        except json.JSONDecodeError:
            continue
        if not isinstance(parsed, dict):
            continue
        _usage_write_record(agent_id, parsed)
        return True
    return False


def _usage_run_omarchy_update(agents: tuple[str, ...]) -> None:
    omarchy = shutil.which("omarchy")
    if not omarchy:
        return
    args = [omarchy, "agent", "usage-update", *agents]
    try:
        subprocess.run(args, capture_output=True, text=True, timeout=180, check=False)
    except Exception:
        pass


def _usage_add_tokens(
    day: str,
    model: str,
    tokens: int,
    *,
    today: str,
    today_tokens: int,
    total_tokens: int,
    model_usage: dict,
) -> tuple[int, int]:
    if tokens <= 0:
        return today_tokens, total_tokens
    total_tokens += tokens
    if day == today:
        today_tokens += tokens
    bucket = model_usage.setdefault(
        model,
        {
            "inputTokens": 0,
            "outputTokens": 0,
            "cacheReadInputTokens": 0,
            "cacheCreationInputTokens": 0,
        },
    )
    bucket["outputTokens"] = _usage_number(bucket.get("outputTokens")) + tokens
    return today_tokens, total_tokens


def _usage_collect_grok_local() -> dict:
    record = _usage_base_record("grok")
    grok_home = Path(os.environ.get("GROK_HOME", str(Path.home() / ".grok")))
    today = _usage_today()
    today_tokens = 0
    total_tokens = 0
    model_usage: dict = {}
    sessions = 0

    if not grok_home.is_dir():
        record["usageStatusText"] = "Grok sessions not found"
        record["authHelpText"] = f"Expected sessions under {grok_home}"
        return record

    for path in grok_home.glob("sessions/**/updates.jsonl"):
        sessions += 1
        try:
            with path.open(encoding="utf-8", errors="replace") as handle:
                for raw in handle:
                    raw = raw.strip()
                    if not raw:
                        continue
                    try:
                        entry = json.loads(raw)
                    except json.JSONDecodeError:
                        continue
                    if entry.get("type") != "turn_completed":
                        continue
                    usage = entry.get("usage") or {}
                    tokens = _usage_number(usage.get("total_tokens"))
                    if not tokens:
                        tokens = (
                            _usage_number(usage.get("input_tokens"))
                            + _usage_number(usage.get("output_tokens"))
                            + _usage_number(usage.get("cache_read_input_tokens"))
                            + _usage_number(usage.get("cache_creation_input_tokens"))
                        )
                    if tokens <= 0:
                        continue
                    ts = entry.get("timestamp") or entry.get("created_at") or path.stat().st_mtime
                    if isinstance(ts, (int, float)):
                        if ts > 10_000_000_000:
                            ts = ts / 1000
                        day = time.strftime("%Y-%m-%d", time.localtime(ts))
                    else:
                        day = str(ts)[:10] if ts else today
                    model = str(entry.get("model") or usage.get("model") or "grok")
                    today_tokens, total_tokens = _usage_add_tokens(
                        day,
                        model,
                        tokens,
                        today=today,
                        today_tokens=today_tokens,
                        total_tokens=total_tokens,
                        model_usage=model_usage,
                    )
        except OSError:
            continue

    if total_tokens > 0:
        record.update(
            {
                "ready": True,
                "hasLocalStats": True,
                "usageStatusText": "",
                "authHelpText": "Weekly quota: Grok Settings → Usage",
                "todayTotalTokens": today_tokens,
                "todayPrompts": today_tokens,
                "todaySessions": sessions,
                "modelUsage": model_usage,
            }
        )
    else:
        record["usageStatusText"] = "No local Grok usage yet"
        record["authHelpText"] = "Run grok CLI sessions; no cloud API calls from this panel."
    return record


def _usage_collect_cursor_local() -> dict:
    record = _usage_base_record("cursor")
    db = Path.home() / ".config/Cursor/User/globalStorage/state.vscdb"
    if not db.is_file():
        record["usageStatusText"] = "Cursor database not found"
        record["authHelpText"] = "Open Cursor on this machine to create ~/.config/Cursor"
        return record

    today = _usage_today()
    today_tokens = 0
    total_tokens = 0
    model_usage: dict = {}
    prompts = 0

    try:
        import sqlite3

        conn = sqlite3.connect(f"file:{db.resolve()}?mode=ro", uri=True, timeout=3)
        conn.execute("PRAGMA query_only = ON")
        rows = conn.execute("SELECT key, value FROM ItemTable").fetchall()
        conn.close()
    except Exception as exc:
        record["usageStatusText"] = "Cursor usage unavailable"
        record["authHelpText"] = str(exc)
        return record

    token_key_re = re.compile(r"token", re.IGNORECASE)

    for key, value in rows:
        if value is None:
            continue
        text = value.decode("utf-8", errors="replace") if isinstance(value, bytes) else str(value)
        if "composer" not in key.lower() and not token_key_re.search(key):
            continue
        try:
            payload = json.loads(text)
        except json.JSONDecodeError:
            continue
        if not isinstance(payload, dict):
            continue

        candidates = [payload]
        if isinstance(payload.get("composerData"), dict):
            candidates.append(payload["composerData"])

        for item in candidates:
            breakdown = item.get("promptTokenBreakdown") or item.get("tokenBreakdown") or {}
            if isinstance(breakdown, dict):
                tokens = sum(_usage_number(v) for v in breakdown.values())
            else:
                tokens = _usage_number(item.get("totalTokens") or item.get("tokens"))
            if tokens <= 0:
                usage = item.get("usage") or {}
                tokens = _usage_number(usage.get("totalTokens") or usage.get("total_tokens"))
            if tokens <= 0:
                continue
            prompts += 1
            model = str(item.get("model") or item.get("modelName") or "cursor")
            today_tokens, total_tokens = _usage_add_tokens(
                today,
                model,
                tokens,
                today=today,
                today_tokens=today_tokens,
                total_tokens=total_tokens,
                model_usage=model_usage,
            )

    if total_tokens > 0:
        record.update(
            {
                "ready": True,
                "hasLocalStats": True,
                "usageStatusText": "Estimated from Cursor local state",
                "authHelpText": "Figures are local estimates; see Cursor admin console for billing.",
                "todayTotalTokens": today_tokens,
                "todayPrompts": prompts,
                "modelUsage": model_usage,
            }
        )
    else:
        record["usageStatusText"] = "No Cursor token data in local state"
        record["authHelpText"] = "Use Cursor on this machine or install a Cursor usage collector."
    return record


def _usage_panel_agent(agent_id: str, record: dict | None) -> dict:
    if record is None:
        base = _usage_base_record(agent_id)
        return {
            "id": agent_id,
            "name": base["name"],
            "available": False,
            "ready": False,
            "tierLabel": "",
            "usageStatusText": "unavailable",
            "authHelpText": base["authHelpText"],
            "todayTotalTokens": 0,
            "todayPrompts": 0,
            "limits": [],
            "updatedAt": base["updatedAt"],
        }

    limits = record.get("limits") if isinstance(record.get("limits"), list) else []
    ready = record.get("ready") is True or _usage_number(record.get("todayTotalTokens")) > 0
    has_stats = record.get("hasLocalStats") is True or bool(record.get("modelUsage"))
    available = ready or has_stats or bool(limits) or bool(record.get("tierLabel"))
    return {
        "id": agent_id,
        "name": str(record.get("name") or AGENT_USAGE_NAMES.get(agent_id, agent_id)),
        "available": available,
        "ready": ready,
        "tierLabel": str(record.get("tierLabel") or ""),
        "usageStatusText": str(record.get("usageStatusText") or ""),
        "authHelpText": str(record.get("authHelpText") or ""),
        "todayTotalTokens": _usage_number(record.get("todayTotalTokens")),
        "todayPrompts": _usage_number(record.get("todayPrompts")),
        "limits": limits,
        "updatedAt": str(record.get("updatedAt") or _usage_now_iso()),
    }


def cmd_ai_usage() -> int:
    agents = [_usage_panel_agent(agent_id, _usage_read_record(agent_id)) for agent_id in AGENT_USAGE_IDS]
    print(json.dumps({"agents": agents, "updatedAt": _usage_now_iso()}, separators=(",", ":")))
    return 0


def cmd_ai_usage_update() -> int:
    USAGE_STATE_DIR.mkdir(parents=True, exist_ok=True)
    _usage_run_omarchy_update(("codex",))

    if not _usage_run_collector("codex"):
        # Keep existing codex.json if omarchy/collector already wrote one.
        if _usage_read_record("codex") is None:
            record = _usage_base_record("codex")
            record["usageStatusText"] = "Codex unavailable"
            record["authHelpText"] = "Run `codex login` or `omarchy agent usage-update codex`"
            _usage_write_record("codex", record)

    for agent_id, local_collector in (
        ("cursor", _usage_collect_cursor_local),
        ("grok", _usage_collect_grok_local),
    ):
        if _usage_run_collector(agent_id):
            continue
        _usage_write_record(agent_id, local_collector())

    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Omarchy Task Manager stats backend")
    parser.add_argument("--version", action="version", version=APP_VERSION)
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("snapshot", help="Emit JSON stats snapshot")
    kill_p = sub.add_parser("kill", help="Terminate a process (SIGTERM then SIGKILL)")
    kill_p.add_argument("pid", type=int)

    sub.add_parser("prefs-get", help="Print prefs.json")
    prefs_set = sub.add_parser("prefs-set", help="Update one prefs.json key")
    prefs_set.add_argument("key")
    prefs_set.add_argument("value")

    sub.add_parser("autostart-get", help="Print autostart.lua enabled state")
    autostart_set = sub.add_parser("autostart-set", help="Enable/disable Hyprland autostart block")
    autostart_set.add_argument("value")

    sub.add_parser("ai-usage", help="Emit aggregated AI usage JSON for Cursor/Codex/Grok")
    sub.add_parser("ai-usage-update", help="Refresh AI usage state files (no Grok API calls)")

    args = parser.parse_args(argv)
    if args.command == "snapshot":
        return cmd_snapshot()
    if args.command == "kill":
        return cmd_kill(args.pid)
    if args.command == "prefs-get":
        return cmd_prefs_get()
    if args.command == "prefs-set":
        return cmd_prefs_set(args.key, args.value)
    if args.command == "autostart-get":
        return cmd_autostart_get()
    if args.command == "autostart-set":
        return cmd_autostart_set(args.value)
    if args.command == "ai-usage":
        return cmd_ai_usage()
    if args.command == "ai-usage-update":
        return cmd_ai_usage_update()

    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
