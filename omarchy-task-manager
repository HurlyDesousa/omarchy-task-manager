def _run_cmd(argv: list[str]) -> str | None:
    """Run argv; return combined stdout+stderr or None on timeout/not-found."""
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    try:
        proc = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=FAN_TIMEOUT,
            check=False,
            stdin=subprocess.DEVNULL,
            env=env,
        )
    except FileNotFoundError:
        return None
    except (subprocess.TimeoutExpired, OSError):
        return None
    except Exception:
        return None
    return ((proc.stdout or "") + "\n" + (proc.stderr or "")).strip()


def _parse_fan_text(output: str | None) -> tuple[int | None, int | None] | None:
    if not output:
        return None
    left_m = LEFT_FAN_RE.search(output)
    right_m = RIGHT_FAN_RE.search(output)
    if left_m is None and right_m is None:
        return None
    left = int(left_m.group(1)) if left_m else None
    right = int(right_m.group(1)) if right_m else None
    return left, right


def _hwmon_fan_speeds() -> tuple[int | None, int | None]:
    """Last-resort: first two fan*_input nodes under /sys/class/hwmon."""
    base = Path("/sys/class/hwmon")
    try:
        hwmons = sorted(base.iterdir())
    except OSError:
        return None, None
    rpms: list[int] = []
    for hw in hwmons:
        for node in sorted(hw.glob("fan*_input")):
            try:
                raw = int(node.read_text(encoding="utf-8").strip())
            except (OSError, ValueError):
                continue
            if raw > 0:
                rpms.append(raw)
            if len(rpms) >= 2:
                return rpms[0], rpms[1]
    if not rpms:
        return None, None
    if len(rpms) == 1:
        return rpms[0], None
    return rpms[0], rpms[1]


def _fan_executable() -> str | None:
    if os.path.isfile(FAN_BIN_PRIMARY):
        return FAN_BIN_PRIMARY
    return shutil.which("x1e-ec-tool")


def _fan_exec(exe: str, args: list[str]) -> str | None:
    """Try exe directly, then sudo -n. Returns output or None."""
    out = _run_cmd([exe] + args)
    if out is not None:
        return out
    sudo = shutil.which("sudo")
    if sudo:
        out = _run_cmd([sudo, "-n", exe] + args)
        if out is not None:
            return out
    return None


def read_fan_speeds() -> tuple[int | None, int | None]:
    """x1e-ec-tool get-speed → sudo -n → hwmon fallback. Never raises."""
    exe = _fan_executable()
    if exe:
        parsed = _parse_fan_text(_fan_exec(exe, ["get-speed"]))
        if parsed is not None:
            return parsed
    return _hwmon_fan_speeds()


def fan_meter_fraction(rpm: int | None) -> float:
    if rpm is None or rpm <= 0:
        return 0.0
    return max(0.0, min(1.0, rpm / FAN_RPM_MAX))


def fmt_fan_meter(rpm: int | None) -> str:
    if rpm is None:
        return EM_DASH
    pct = fan_meter_fraction(rpm) * 100.0
    return f"{rpm} {pct:.0f}%"


